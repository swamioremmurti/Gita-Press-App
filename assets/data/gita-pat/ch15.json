{"ch":15,"v":[{"n":1,"d":8.71,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["ऊर्ध्वमूलमधःशाखमश्वत्थं प्राहुरव्ययम्।",0.0,3.05],["छन्दांसि यस्य पर्णानि यस्तं वेद स वेदवित्॥",4.61,8.71]]},{"n":2,"d":12.13,"p":[["अधश्चोर्ध्वं प्रसृतास्तस्य शाखा",0.0,3.48],["गुणप्रवृद्धा विषयप्रवालाः।",3.45,5.36],["अधश्च मूलान्यनुसन्ततानि",6.36,8.87],["कर्मानुबन्धीनि मनुष्यलोके॥",8.84,12.13]]},{"n":3,"d":12.25,"p":[["न रूपमस्येह तथोपलभ्यते",0.0,2.95],["नान्तो न चादिर्न च सम्प्रतिष्ठा।",3.25,6.19],["अश्वत्थमेनं सुविरूढमूल-",6.16,7.67],["मसङ्गशस्त्रेण दृढेन छित्त्वा॥",9.16,12.25]]},{"n":4,"d":12.05,"p":[["ततः पदं तत्परिमार्गितव्यं",0.0,2.72],["यस्मिन्गता न निवर्तन्ति भूयः।",2.97,5.96],["तमेव चाद्यं पुरुषं प्रपद्ये",5.93,7.59],["यतः प्रवृत्तिः प्रसृता पुराणी॥",9.08,12.05]]},{"n":5,"d":11.07,"p":[["निर्मानमोहा जितसङ्गदोषा",0.0,2.53],["अध्यात्मनित्या विनिवृत्तकामाः।",2.5,4.34],["द्वन्द्वैर्विमुक्ताः सुखदुःखसञ्ज्ञैर्-",5.22,7.38],["गच्छन्त्यमूढाः पदमव्ययं तत्॥",8.25,11.07]]},{"n":6,"d":9.33,"p":[["न तद्भासयते सूर्यो न शशाङ्को न पावकः।",0.0,4.67],["यद्‍गत्वा न निवर्तन्ते तद्धाम परमं मम॥",4.64,9.33]]},{"n":7,"d":9.37,"p":[["ममैवांशो जीवलोके जीवभूतः सनातनः।",0.0,4.99],["मनःषष्ठानीन्द्रियाणि प्रकृतिस्थानि कर्षति॥",4.96,9.37]]},{"n":8,"d":9.95,"p":[["शरीरं यदवाप्नोति यच्चाप्युत्क्रामतीश्वरः।",0.01,5.16],["गृहीत्वैतानि संयाति वायुर्गन्धानिवाशयात्॥",5.13,9.95]]},{"n":9,"d":8.67,"p":[["श्रोत्रं चक्षुः स्पर्शनं च रसनं घ्राणमेव च।",0.0,4.8],["अधिष्ठाय मनश्चायं विषयानुपसेवते॥",4.77,8.67]]},{"n":10,"d":9.89,"p":[["उत्क्रामन्तं स्थितं वापि भुञ्जानं वा गुणान्वितम्।",0.0,5.07],["विमूढा नानुपश्यन्ति पश्यन्ति ज्ञानचक्षुषः॥",5.04,9.89]]},{"n":11,"d":9.63,"p":[["यतन्तो योगिनश्चैनं पश्यन्त्यात्मन्यवस्थितम्।",0.0,4.92],["यतन्तोऽप्यकृतात्मानो नैनं पश्यन्त्यचेतसः॥",4.89,9.63]]},{"n":12,"d":8.67,"p":[["यदादित्यगतं तेजो जगद्भासयतेऽखिलम्।",0.0,3.93],["यच्चन्द्रमसि यच्चाग्नौ तत्तेजो विद्धि मामकम्॥",3.9,8.67]]},{"n":13,"d":9.73,"p":[["गामाविश्य च भूतानि धारयाम्यहमोजसा।",0.0,4.16],["पुष्णामि चौषधीः सर्वाः सोमो भूत्वा रसात्मकः॥",4.13,9.73]]},{"n":14,"d":9.33,"p":[["अहं वैश्वानरो भूत्वा प्राणिनां देहमाश्रितः।",0.0,4.52],["प्राणापानसमायुक्तः पचाम्यन्नं चतुर्विधम्॥",4.49,9.33]]},{"n":15,"d":10.97,"p":[["सर्वस्य चाहं हृदि सन्निविष्टो",0.0,2.58],["मत्तः स्मृतिर्ज्ञानमपोहनं च।",2.85,5.4],["वेदैश्च सर्वैरहमेव वेद्यो",5.37,7.95],["वेदान्तकृद्वेदविदेव चाहम्॥",7.92,10.97]]},{"n":16,"d":8.85,"p":[["द्वाविमौ पुरुषौ लोके क्षरश्चाक्षर एव च।",0.0,4.47],["क्षरः सर्वाणि भूतानि कूटस्थोऽक्षर उच्यते॥",4.44,8.85]]},{"n":17,"d":9.27,"p":[["उत्तमः पुरुषस्त्वन्यः परमात्मेत्युदाहृतः।",0.0,3.47],["यो लोकत्रयमाविश्य बिभर्त्यव्यय ईश्वरः॥",4.34,9.27]]},{"n":18,"d":8.45,"p":[["यस्मात्क्षरमतीतोऽहमक्षरादपि चोत्तमः।",0.0,3.62],["अतोऽस्मि लोके वेदे च प्रथितः पुरुषोत्तमः॥",4.24,8.45]]},{"n":19,"d":8.57,"p":[["यो मामेवमसम्मूढो जानाति पुरुषोत्तमम्।",0.0,4.39],["स सर्वविद्भजति मां सर्वभावेन भारत॥",4.36,8.57]]},{"n":20,"d":9.21,"p":[["इति गुह्यतमं शास्त्रमिदमुक्तं मयानघ।",0.0,2.96],["एतद्‍बुद्‍ध्‍वा बुद्धिमान्स्यात् कृतकृत्यश्च भारत॥",4.41,9.21]]}]}