{"ch":9,"v":[{"n":1,"d":9.87,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["इदं तु ते गुह्यतमं प्रवक्ष्याम्यनसूयवे।",0.0,4.32],["ज्ञानं विज्ञानसहितं यज्ज्ञात्वा मोक्ष्यसेऽशुभात्॥",4.85,9.87]]},{"n":2,"d":9.49,"p":[["राजविद्या राजगुह्यं पवित्रमिदमुत्तमम्।",0.0,4.46],["प्रत्यक्षावगमं धर्म्यं सुसुखं कर्तुमव्ययम्॥",5.0,9.49]]},{"n":3,"d":9.67,"p":[["अश्रद्दधानाः पुरुषा धर्मस्यास्य परन्तप।",0.0,4.71],["अप्राप्य मां निवर्तन्ते मृत्युसंसारवर्त्मनि॥",5.05,9.67]]},{"n":4,"d":9.19,"p":[["मया ततमिदं सर्वं जगदव्यक्तमूर्तिना।",0.0,4.27],["मत्स्थानि सर्वभूतानि न चाहं तेष्ववस्थितः॥",4.65,9.19]]},{"n":5,"d":10.19,"p":[["न च मत्स्थानि भूतानि पश्य मे योगमैश्वरम्।",0.0,4.51],["भूतभृन्न च भूतस्थो ममात्मा भूतभावनः॥",5.17,10.19]]},{"n":6,"d":10.01,"p":[["यथाकाशस्थितो नित्यं वायुः सर्वत्रगो महान्।",0.0,4.89],["तथा सर्वाणि भूतानि मत्स्थानीत्युपधारय॥",5.44,10.01]]},{"n":7,"d":9.81,"p":[["सर्वभूतानि कौन्तेय प्रकृतिं यान्ति मामिकाम्।",0.0,4.65],["कल्पक्षये पुनस्तानि कल्पादौ विसृजाम्यहम्॥",5.2,9.81]]},{"n":8,"d":9.25,"p":[["प्रकृतिं स्वामवष्टभ्य विसृजामि पुनः पुनः।",0.0,4.4],["भूतग्राममिमं कृत्स्न-मवशं प्रकृतेर्वशात्॥",4.84,9.25]]},{"n":9,"d":8.81,"p":[["न च मां तानि कर्माणि निबध्नन्ति धनञ्जय।",0.0,4.29],["उदासीनवदासीनमसक्तं तेषु कर्मसु॥",4.64,8.81]]},{"n":10,"d":9.19,"p":[["मयाध्यक्षेण प्रकृतिः सूयते सचराचरम्।",0.0,4.46],["हेतुनानेन कौन्तेय जगद्विपरिवर्तते॥",5.01,9.19]]},{"n":11,"d":9.43,"p":[["अवजानन्ति मां मूढा मानुषीं तनुमाश्रितम्।",0.0,4.45],["परं भावमजानन्तो मम भूतमहेश्वरम्॥",5.01,9.43]]},{"n":12,"d":10.15,"p":[["मोघाशा मोघकर्माणो मोघज्ञाना विचेतसः।",0.0,5.19],["राक्षसीमासुरीं चैव प्रकृतिं मोहिनीं श्रिताः॥",5.61,10.15]]},{"n":13,"d":9.93,"p":[["महात्मानस्तु मां पार्थ दैवीं प्रकृतिमाश्रिताः।",0.0,4.77],["भजन्त्यनन्यमनसो ज्ञात्वा भूतादिमव्ययम्॥",5.2,9.93]]},{"n":14,"d":9.89,"p":[["सततं कीर्तयन्तो मां यतन्तश्च दृढव्रताः।",0.0,4.75],["नमस्यन्तश्च मां भक्त्या नित्ययुक्ता उपासते॥",5.12,9.89]]},{"n":15,"d":9.71,"p":[["ज्ञानयज्ञेन चाप्यन्ये यजन्तो मामुपासते।",0.0,4.85],["एकत्वेन पृथक्त्वेन बहुधा विश्वतोमुखम्॥",5.25,9.71]]},{"n":16,"d":8.93,"p":[["अहं क्रतुरहं यज्ञः स्वधाहमहमौषधम्।",0.0,4.24],["मन्त्रोऽहमहमेवाज्यमहमग्निरहं हुतम्॥",4.84,8.93]]},{"n":17,"d":9.27,"p":[["पिताहमस्य जगतो माता धाता पितामहः।",0.0,4.46],["वेद्यं पवित्रमोङ्कार ऋक्साम यजुरेव च॥",4.85,9.27]]},{"n":18,"d":9.51,"p":[["गतिर्भर्ता प्रभुः साक्षी निवासः शरणं सुहृत्।",0.0,4.37],["प्रभवः प्रलयः स्थानं निधानं बीजमव्ययम्॥",4.89,9.51]]},{"n":19,"d":9.09,"p":[["तपाम्यहमहं वर्षं निगृह्णाम्युत्सृजामि च।",0.0,4.42],["अमृतं चैव मृत्युश्च सदसच्चाहमर्जुन॥",4.76,9.09]]},{"n":20,"d":15.12,"p":[["त्रैविद्या मां सोमपाः पूतपापा",0.0,3.64],["यज्ञैरिष्ट्वा स्वर्गतिं प्रार्थयन्ते।",4.01,7.57],["ते पुण्यमासाद्य सुरेन्द्रलोक-",7.92,11.39],["मश्नन्ति दिव्यान्दिवि देवभोगान्॥",11.75,15.12]]},{"n":21,"d":14.73,"p":[["ते तं भुक्त्वा स्वर्गलोकं विशालं",0.0,3.52],["क्षीणे पुण्ये मर्त्यलोकं विशन्ति।",4.01,7.56],["एवं त्रयीधर्ममनुप्रपन्ना",7.96,11.23],["गतागतं कामकामा लभन्ते॥",11.63,14.73]]},{"n":22,"d":10.35,"p":[["अनन्याश्चिन्तयन्तो मां ये जनाः पर्युपासते।",0.0,4.78],["तेषां नित्याभियुक्तानां योगक्षेमं वहाम्यहम्॥",5.13,10.35]]},{"n":23,"d":9.77,"p":[["येऽप्यन्यदेवता भक्ता यजन्ते श्रद्धयान्विताः।",0.0,5.0],["तेऽपि मामेव कौन्तेय यजन्त्यविधिपूर्वकम्॥",5.36,9.77]]},{"n":24,"d":9.45,"p":[["अहं हि सर्वयज्ञानां भोक्ता च प्रभुरेव च।",0.0,4.74],["न तु मामभिजानन्ति तत्त्वेनातश्च्यवन्ति ते॥",5.08,9.45]]},{"n":25,"d":10.23,"p":[["यान्ति देवव्रता देवान् पितॄन्यान्ति पितृव्रताः।",0.0,4.79],["भूतानि यान्ति भूतेज्या यान्ति मद्याजिनोऽपि माम्॥",5.29,10.23]]},{"n":26,"d":9.53,"p":[["पत्रं पुष्पं फलं तोयं यो मे भक्त्या प्रयच्छति।",0.0,4.83],["तदहं भक्त्युपहृतमश्नामि प्रयतात्मनः॥",5.16,9.53]]},{"n":27,"d":8.61,"p":[["यत्करोषि यदश्नासि यज्जुहोषि ददासि यत्।",0.0,3.77],["यत्तपस्यसि कौन्तेय तत्कुरुष्व मदर्पणम्॥",4.32,8.61]]},{"n":28,"d":10.01,"p":[["शुभाशुभफलैरेवं मोक्ष्यसे कर्मबन्धनैः।",0.01,5.05],["सन्न्यासयोगयुक्तात्मा विमुक्तो मामुपैष्यसि॥",5.44,10.01]]},{"n":29,"d":10.17,"p":[["समोऽहं सर्वभूतेषु न मे द्वेष्योऽस्ति न प्रियः।",0.0,4.97],["ये भजन्ति तु मां भक्त्या मयि ते तेषु चाप्यहम्॥",5.36,10.17]]},{"n":30,"d":9.33,"p":[["अपि चेत्सुदुराचारो भजते मामनन्यभाक्।",0.0,4.37],["साधुरेव स मन्तव्यः सम्यग्व्यवसितो हि सः॥",4.96,9.33]]},{"n":31,"d":9.37,"p":[["क्षिप्रं भवति धर्मात्मा शश्वच्छान्तिं निगच्छति।",0.0,4.67],["कौन्तेय प्रति जानीहि न मे भक्तः प्रणश्यति॥",5.0,9.37]]},{"n":32,"d":10.19,"p":[["मां हि पार्थ व्यपाश्रित्य येऽपि स्युः पापयोनयः।",0.0,5.15],["स्त्रियो वैश्यास्तथा शूद्रास्-तेऽपि यान्ति परां गतिम्॥",5.49,10.19]]},{"n":33,"d":9.71,"p":[["किं पुनर्ब्राह्मणाः पुण्या भक्ता राजर्षयस्तथा।",0.0,5.0],["अनित्यमसुखं लोकमिमं प्राप्य भजस्व माम्॥",5.33,9.71]]},{"n":34,"d":10.11,"p":[["मन्मना भव मद्भक्तो मद्याजी मां नमस्कुरु।",0.0,4.71],["मामेवैष्यसि युक्त्वैवमात्मानं मत्परायणः॥",5.13,10.11]]}]}