{"ch":17,"v":[{"n":1,"d":9.95,"p":[["अर्जुन उवाच",0.0,1.37,"UV_arjuna"],["ये शास्त्रविधिमुत्सृज्य यजन्ते श्रद्धयान्विताः।",0.0,4.77],["तेषां निष्ठा तु का कृष्ण सत्त्वमाहो रजस्तमः॥",4.74,9.95]]},{"n":2,"d":9.11,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["त्रिविधा भवति श्रद्धा देहिनां सा स्वभावजा।",0.0,4.84],["सात्त्विकी राजसी चैव तामसी चेति तां शृणु॥",4.81,9.11]]},{"n":3,"d":9.37,"p":[["सत्त्वानुरूपा सर्वस्य श्रद्धा भवति भारत।",0.0,4.28],["श्रद्धामयोऽयं पुरुषो यो यच्छ्रद्धः स एव सः॥",4.25,9.37]]},{"n":4,"d":9.33,"p":[["यजन्ते सात्त्विका देवान् यक्षरक्षांसि राजसाः।",0.0,4.2],["प्रेतान्भूतगणांश्चान्ये यजन्ते तामसा जनाः॥",4.17,9.33]]},{"n":5,"d":9.53,"p":[["अशास्त्रविहितं घोरं तप्यन्ते ये तपो जनाः।",0.0,4.56],["दम्भाहङ्कारसंयुक्ताः कामरागबलान्विताः॥",4.53,9.53]]},{"n":6,"d":9.95,"p":[["कर्शयन्तः शरीरस्थं भूतग्राममचेतसः।",0.0,4.73],["मां चैवान्तःशरीरस्थं तान्विद्‍ध्‍यासुरनिश्चयान्॥",4.7,9.95]]},{"n":7,"d":9.11,"p":[["आहारस्त्वपि सर्वस्य त्रिविधो भवति प्रियः।",0.0,4.25],["यज्ञस्तपस्तथा दानं तेषां भेदमिमं शृणु॥",4.22,9.11]]},{"n":8,"d":8.95,"p":[["आयुःसत्त्वबलारोग्यसुखप्रीतिविवर्धनाः।",0.0,3.65],["रस्याः स्निग्धाः स्थिरा हृद्या आहाराः सात्त्विकप्रियाः॥",3.62,8.95]]},{"n":9,"d":8.75,"p":[["कट्वम्ललवणात्युष्णतीक्ष्णरूक्षविदाहिनः।",0.0,4.01],["आहारा राजसस्येष्टा दुःखशोकामयप्रदाः॥",3.98,8.75]]},{"n":10,"d":9.03,"p":[["यातयामं गतरसं पूति पर्युषितं च यत्।",0.0,4.64],["उच्छिष्टमपि चामेध्यं भोजनं तामसप्रियम्॥",4.61,9.03]]},{"n":11,"d":9.17,"p":[["अफलाकाङ्क्षिभिर्यज्ञो विधिदृष्टो य इज्यते।",0.0,4.56],["यष्टव्यमेवेति मनः समाधाय स सात्त्विकः॥",4.53,9.17]]},{"n":12,"d":8.85,"p":[["अभिसन्धाय तु फलं दम्भार्थमपि चैव यत्।",0.0,4.36],["इज्यते भरतश्रेष्ठ तं यज्ञं विद्धि राजसम्॥",4.33,8.85]]},{"n":13,"d":8.63,"p":[["विधिहीनमसृष्टान्नं मन्त्रहीनमदक्षिणम्।",0.0,4.4],["श्रद्धाविरहितं यज्ञं तामसं परिचक्षते॥",4.37,8.63]]},{"n":14,"d":8.75,"p":[["देवद्विजगुरुप्राज्ञपूजनं शौचमार्जवम्।",0.0,2.93],["ब्रह्मचर्यमहिंसा च शारीरं तप उच्यते॥",4.53,8.75]]},{"n":15,"d":8.83,"p":[["अनुद्वेगकरं वाक्यं सत्यं प्रियहितं च यत्।",0.0,4.4],["स्वाध्यायाभ्यसनं चैव वाङ्मयं तप उच्यते॥",4.37,8.83]]},{"n":16,"d":9.35,"p":[["मनःप्रसादः सौम्यत्वं मौनमात्मविनिग्रहः।",0.0,4.92],["भावसंशुद्धिरित्येतत् तपो मानसमुच्यते॥",4.89,9.35]]},{"n":17,"d":9.41,"p":[["श्रद्धया परया तप्तं तपस्तत्त्रिविधं नरैः।",0.0,3.95],["अफलाकाङ्क्षिभिर्युक्तैः सात्त्विकं परिचक्षते॥",4.8,9.41]]},{"n":18,"d":8.87,"p":[["सत्कारमानपूजार्थं तपो दम्भेन चैव यत्।",0.0,4.44],["क्रियते तदिह प्रोक्तं राजसं चलमध्रुवम्॥",4.41,8.87]]},{"n":19,"d":9.21,"p":[["मूढग्राहेणात्मनो यत् पीडया क्रियते तपः।",0.0,4.28],["परस्योत्सादनार्थं वा तत्तामसमुदाहृतम्॥",4.25,9.21]]},{"n":20,"d":9.05,"p":[["दातव्यमिति यद्दानं दीयतेऽनुपकारिणे।",0.0,3.96],["देशे काले च पात्रे च तद्दानं सात्त्विकं स्मृतम्॥",3.93,9.05]]},{"n":21,"d":8.89,"p":[["यत्तु प्रत्युपकारार्थं फलमुद्दिश्य वा पुनः।",0.0,4.47],["दीयते च परिक्लिष्टं तद्दानं राजसं स्मृतम्॥",4.44,8.89]]},{"n":22,"d":8.31,"p":[["अदेशकाले यद्दानमपात्रेभ्यश्च दीयते।",0.0,4.13],["असत्कृतमवज्ञातं तत्तामसमुदाहृतम्॥",4.1,8.31]]},{"n":23,"d":8.67,"p":[["ॐ तत्सदिति निर्देशो ब्रह्मणस्त्रिविधः स्मृतः।",0.0,3.85],["ब्राह्मणास्तेन वेदाश्च यज्ञाश्च विहिताः पुरा॥",3.82,8.67]]},{"n":24,"d":9.21,"p":[["तस्मादोमित्युदाहृत्य यज्ञदानतपःक्रियाः।",0.0,3.5],["प्रवर्तन्ते विधानोक्ताः सततं ब्रह्मवादिनाम्॥",4.17,9.21]]},{"n":25,"d":8.57,"p":[["तदित्यनभिसन्धाय फलं यज्ञतपःक्रियाः।",0.0,4.43],["दानक्रियाश्च विविधाः क्रियन्ते मोक्षकाङ्क्षिभिः॥",4.4,8.57]]},{"n":26,"d":8.77,"p":[["सद्भावे साधुभावे च सदित्येतत्प्रयुज्यते।",0.05,3.39],["प्रशस्ते कर्मणि तथा सच्छब्दः पार्थ युज्यते॥",4.29,8.77]]},{"n":27,"d":8.93,"p":[["यज्ञे तपसि दाने च स्थितिः सदिति चोच्यते।",0.0,4.36],["कर्म चैव तदर्थीयं सदित्येवाभिधीयते॥",4.33,8.93]]},{"n":28,"d":9.17,"p":[["अश्रद्धया हुतं दत्तं तपस्तप्तं कृतं च यत्।",0.0,3.59],["असदित्युच्यते पार्थ न च तत्प्रेत्य नो इह॥",4.84,9.17]]}]}