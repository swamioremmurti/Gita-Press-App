{"ch":10,"v":[{"n":1,"d":9.25,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["भूय एव महाबाहो शृणु मे परमं वचः।",0.0,4.44],["यत्तेऽहं प्रीयमाणाय वक्ष्यामि हितकाम्यया॥",4.8,9.25]]},{"n":2,"d":9.31,"p":[["न मे विदुः सुरगणाः प्रभवं न महर्षयः।",0.0,4.24],["अहमादिर्हि देवानां महर्षीणां च सर्वशः॥",4.61,9.31]]},{"n":3,"d":9.47,"p":[["यो मामजमनादिं च वेत्ति लोकमहेश्वरम्।",0.0,4.39],["असम्मूढः स मर्त्येषु सर्वपापैः प्रमुच्यते॥",4.97,9.47]]},{"n":4,"d":9.81,"p":[["बुद्धिर्ज्ञानमसम्मोहः क्षमा सत्यं दमः शमः।",0.0,4.88],["सुखं दुःखं भवोऽभावो भयं चाभयमेव च॥",5.24,9.81]]},{"n":5,"d":9.89,"p":[["अहिंसा समता तुष्टिस्-तपो दानं यशोऽयशः।",0.0,4.72],["भवन्ति भावा भूतानां मत्त एव पृथग्विधाः॥",5.2,9.89]]},{"n":6,"d":9.91,"p":[["महर्षयः सप्त पूर्वे चत्वारो मनवस्तथा।",0.0,4.55],["मद्भावा मानसा जाता येषां लोक इमाः प्रजाः॥",4.93,9.91]]},{"n":7,"d":9.39,"p":[["एतां विभूतिं योगं च मम यो वेत्ति तत्त्वतः।",0.0,4.61],["सोऽविकम्पेन योगेन युज्यते नात्र संशयः॥",5.01,9.39]]},{"n":8,"d":9.51,"p":[["अहं सर्वस्य प्रभवो मत्तः सर्वं प्रवर्तते।",0.0,4.49],["इति मत्वा भजन्ते मां बुधा भावसमन्विताः॥",4.85,9.51]]},{"n":9,"d":9.71,"p":[["मच्चित्ता मद्‍गतप्राणा बोधयन्तः परस्परम्।",0.0,4.79],["कथयन्तश्च मां नित्यं तुष्यन्ति च रमन्ति च॥",5.37,9.71]]},{"n":10,"d":9.91,"p":[["तेषां सततयुक्तानां भजतां प्रीतिपूर्वकम्।",0.0,4.93],["ददामि बुद्धियोगं तं येन मामुपयान्ति ते॥",5.57,9.91]]},{"n":11,"d":9.89,"p":[["तेषामेवानुकम्पार्थ-महमज्ञानजं तमः।",0.0,4.55],["नाशयाम्यात्मभावस्थो ज्ञानदीपेन भास्वता॥",4.96,9.89]]},{"n":12,"d":9.37,"p":[["अर्जुन उवाच",0.0,1.37,"UV_arjuna"],["परं ब्रह्म परं धाम पवित्रं परमं भवान्।",0.0,4.41],["पुरुषं शाश्वतं दिव्यमादिदेवमजं विभुम्॥",4.96,9.37]]},{"n":13,"d":9.61,"p":[["आहुस्त्वामृषयः सर्वे देवर्षिर्नारदस्तथा।",0.0,4.83],["असितो देवलो व्यासः स्वयं चैव ब्रवीषि मे॥",5.16,9.61]]},{"n":14,"d":9.25,"p":[["सर्वमेतदृतं मन्ये यन्मां वदसि केशव।",0.0,4.45],["न हि ते भगवन्व्यक्तिं विदुर्देवा न दानवाः॥",4.8,9.25]]},{"n":15,"d":9.13,"p":[["स्वयमेवात्मनात्मानं वेत्थ त्वं पुरुषोत्तम।",0.0,4.52],["भूतभावन भूतेश देवदेव जगत्पते॥",5.0,9.13]]},{"n":16,"d":9.79,"p":[["वक्तुमर्हस्यशेषेण दिव्या ह्यात्मविभूतयः।",0.0,4.63],["याभिर्विभूतिभिर्लोकानिमांस्त्वं व्याप्य तिष्ठसि॥",5.05,9.79]]},{"n":17,"d":9.55,"p":[["कथं विद्यामहं योगिंस्-त्वां सदा परिचिन्तयन्।",0.0,4.66],["केषु केषु च भावेषु चिन्त्योऽसि भगवन्मया॥",5.25,9.55]]},{"n":18,"d":9.67,"p":[["विस्तरेणात्मनो योगं विभूतिं च जनार्दन।",0.0,4.51],["भूयः कथय तृप्तिर्हि शृण्वतो नास्ति मेऽमृतम्॥",4.97,9.67]]},{"n":19,"d":9.73,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["हन्त ते कथयिष्यामि दिव्या ह्यात्मविभूतयः।",0.0,4.65],["प्राधान्यतः कुरुश्रेष्ठ नास्त्यन्तो विस्तरस्य मे॥",5.0,9.73]]},{"n":20,"d":9.65,"p":[["अहमात्मा गुडाकेश सर्वभूताशयस्थितः।",0.0,4.59],["अहमादिश्च मध्यं च भूतानामन्त एव च॥",4.96,9.65]]},{"n":21,"d":9.81,"p":[["आदित्यानामहं विष्णुर्-ज्योतिषां रविरंशुमान्।",0.0,4.87],["मरीचिर्मरुतामस्मि नक्षत्राणामहं शशी॥",5.44,9.81]]},{"n":22,"d":10.19,"p":[["वेदानां सामवेदोऽस्मि देवानामस्मि वासवः।",0.0,5.05],["इन्द्रियाणां मनश्चास्मि भूतानामस्मि चेतना॥",5.41,10.19]]},{"n":23,"d":10.15,"p":[["रुद्राणां शङ्करश्चास्मि वित्तेशो यक्षरक्षसाम्।",0.0,5.07],["वसूनां पावकश्चास्मि मेरुः शिखरिणामहम्॥",5.65,10.15]]},{"n":24,"d":10.17,"p":[["पुरोधसां च मुख्यं मां विद्धि पार्थ बृहस्पतिम्।",0.0,4.77],["सेनानीनामहं स्कन्दः सरसामस्मि सागरः॥",5.36,10.17]]},{"n":25,"d":10.01,"p":[["महर्षीणां भृगुरहं गिरामस्म्येकमक्षरम्।",0.0,4.47],["यज्ञानां जपयज्ञोऽस्मि स्थावराणां हिमालयः॥",5.0,10.01]]},{"n":26,"d":10.15,"p":[["अश्वत्थः सर्ववृक्षाणां देवर्षीणां च नारदः।",0.0,5.25],["गन्धर्वाणां चित्ररथः सिद्धानां कपिलो मुनिः॥",5.69,10.15]]},{"n":27,"d":9.61,"p":[["उच्चैःश्रवसमश्वानां विद्धि माममृतोद्भवम्।",0.0,4.43],["ऐरावतं गजेन्द्राणां नराणां च नराधिपम्॥",5.12,9.61]]},{"n":28,"d":9.35,"p":[["आयुधानामहं वज्रं धेनूनामस्मि कामधुक्।",0.0,4.27],["प्रजनश्चास्मि कन्दर्पः सर्पाणामस्मि वासुकिः॥",4.81,9.35]]},{"n":29,"d":9.81,"p":[["अनन्तश्चास्मि नागानां वरुणो यादसामहम्।",0.0,4.77],["पितॄणामर्यमा चास्मि यमः संयमतामहम्॥",5.32,9.81]]},{"n":30,"d":10.57,"p":[["प्रह्लादश्चास्मि दैत्यानां कालः कलयतामहम्।",0.0,5.16],["मृगाणां च मृगेन्द्रोऽहं वैनतेयश्च पक्षिणाम्॥",5.72,10.57]]},{"n":31,"d":9.49,"p":[["पवनः पवतामस्मि रामः शस्त्रभृतामहम्।",0.0,4.4],["झषाणां मकरश्चास्मि स्रोतसामस्मि जाह्नवी॥",5.12,9.49]]},{"n":32,"d":9.99,"p":[["सर्गाणामादिरन्तश्च मध्यं चैवाहमर्जुन।",0.0,4.79],["अध्यात्मविद्या विद्यानां वादः प्रवदतामहम्॥",5.17,9.99]]},{"n":33,"d":9.99,"p":[["अक्षराणामकारोऽस्मि द्वन्द्वः सामासिकस्य च।",0.0,4.93],["अहमेवाक्षयः कालो धाताहं विश्वतोमुखः॥",5.29,9.99]]},{"n":34,"d":10.21,"p":[["मृत्युः सर्वहरश्चाहमुद्भवश्च भविष्यताम्।",0.0,4.6],["कीर्तिः श्रीर्वाक्च नारीणां स्मृतिर्मेधा धृतिः क्षमा॥",5.16,10.21]]},{"n":35,"d":10.57,"p":[["बृहत्साम तथा साम्नां गायत्री छन्दसामहम्।",0.0,4.88],["मासानां मार्गशीर्षोऽहमृतूनां कुसुमाकरः॥",5.48,10.57]]},{"n":36,"d":9.89,"p":[["द्यूतं छलयतामस्मि तेजस्तेजस्विनामहम्।",0.0,4.72],["जयोऽस्मि व्यवसायोऽस्मि सत्त्वं सत्त्ववतामहम्॥",5.32,9.89]]},{"n":37,"d":9.79,"p":[["वृष्णीनां वासुदेवोऽस्मि पाण्डवानां धनञ्जयः।",0.0,5.06],["मुनीनामप्यहं व्यासः कवीनामुशना कविः॥",5.45,9.79]]},{"n":38,"d":10.07,"p":[["दण्डो दमयतामस्मि नीतिरस्मि जिगीषताम्।",0.0,4.46],["मौनं चैवास्मि गुह्यानां ज्ञानं ज्ञानवतामहम्॥",5.09,10.07]]},{"n":39,"d":9.41,"p":[["यच्चापि सर्वभूतानां बीजं तदहमर्जुन।",0.0,4.53],["न तदस्ति विना यत्स्यान् मया भूतं चराचरम्॥",4.88,9.41]]},{"n":40,"d":9.93,"p":[["नान्तोऽस्ति मम दिव्यानां विभूतीनां परन्तप।",0.0,4.87],["एष तूद्देशतः प्रोक्तो विभूतेर्विस्तरो मया॥",5.28,9.93]]},{"n":41,"d":9.37,"p":[["यद्यद्विभूतिमत्सत्त्वं श्रीमदूर्जितमेव वा।",0.0,4.51],["तत्तदेवावगच्छ त्वं मम तेजोंऽशसम्भवम्॥",4.84,9.37]]},{"n":42,"d":9.21,"p":[["अथवा बहुनैतेन किं ज्ञातेन तवार्जुन।",0.0,4.35],["विष्टभ्याहमिदं कृत्स्नमेकांशेन स्थितो जगत्॥",4.72,9.21]]}]}