{"ch":7,"v":[{"n":1,"d":9.95,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["मय्यासक्तमनाः पार्थ योगं युञ्जन्मदाश्रयः।",0.0,5.15],["असंशयं समग्रं मां यथा ज्ञास्यसि तच्छृणु॥",5.49,9.95]]},{"n":2,"d":10.19,"p":[["ज्ञानं तेऽहं सविज्ञानमिदं वक्ष्याम्यशेषतः।",0.0,5.16],["यज्ज्ञात्वा नेह भूयोऽन्यज्-ज्ञातव्यमवशिष्यते॥",5.49,10.19]]},{"n":3,"d":9.95,"p":[["मनुष्याणां सहस्रेषु कश्चिद्यतति सिद्धये।",0.0,4.47],["यततामपि सिद्धानां कश्चिन्मां वेत्ति तत्त्वतः॥",4.86,9.95]]},{"n":4,"d":9.39,"p":[["भूमिरापोऽनलो वायुः खं मनो बुद्धिरेव च।",0.0,4.6],["अहङ्कार इतीयं मे भिन्ना प्रकृतिरष्टधा॥",4.97,9.39]]},{"n":5,"d":9.65,"p":[["अपरेयमितस्त्वन्यां प्रकृतिं विद्धि मे पराम्।",0.0,4.55],["जीवभूतां महाबाहो ययेदं धार्यते जगत्॥",5.2,9.65]]},{"n":6,"d":9.35,"p":[["एतद्योनीनि भूतानि सर्वाणीत्युपधारय।",0.0,4.83],["अहं कृत्स्नस्य जगतः प्रभवः प्रलयस्तथा॥",5.21,9.35]]},{"n":7,"d":9.03,"p":[["मत्तः परतरं नान्यत् किञ्चिदस्ति धनञ्जय।",0.0,4.41],["मयि सर्वमिदं प्रोतं सूत्रे मणिगणा इव॥",4.81,9.03]]},{"n":8,"d":9.23,"p":[["रसोऽहमप्सु कौन्तेय प्रभास्मि शशिसूर्ययोः।",0.0,4.43],["प्रणवः सर्ववेदेषु शब्दः खे पौरुषं नृषु॥",4.77,9.23]]},{"n":9,"d":9.59,"p":[["पुण्यो गन्धः पृथिव्यां च तेजश्चास्मि विभावसौ।",0.0,4.89],["जीवनं सर्वभूतेषु तपश्चास्मि तपस्विषु॥",5.37,9.59]]},{"n":10,"d":10.23,"p":[["बीजं मां सर्वभूतानां विद्धि पार्थ सनातनम्।",0.0,4.91],["बुद्धिर्बुद्धिमतामस्मि तेजस्तेजस्विनामहम्॥",5.53,10.23]]},{"n":11,"d":9.59,"p":[["बलं बलवतां चाहं कामरागविवर्जितम्।",0.0,4.41],["धर्माविरुद्धो भूतेषु कामोऽस्मि भरतर्षभ॥",5.09,9.59]]},{"n":12,"d":9.51,"p":[["ये चैव सात्त्विका भावा राजसास्तामसाश्च ये।",0.0,4.91],["मत्त एवेति तान्विद्धि न त्वहं तेषु ते मयि॥",5.29,9.51]]},{"n":13,"d":9.01,"p":[["त्रिभिर्गुणमयैर्भावैरेभिः सर्वमिदं जगत्।",0.0,3.97],["मोहितं नाभिजानाति मामेभ्यः परमव्ययम्॥",4.56,9.01]]},{"n":14,"d":9.73,"p":[["दैवी ह्येषा गुणमयी मम माया दुरत्यया।",0.0,4.5],["मामेव ये प्रपद्यन्ते मायामेतां तरन्ति ते॥",4.92,9.73]]},{"n":15,"d":10.01,"p":[["न मां दुष्कृतिनो मूढाः प्रपद्यन्ते नराधमाः।",0.0,4.87],["माययापहृतज्ञाना आसुरं भावमाश्रिताः॥",5.28,10.01]]},{"n":16,"d":9.73,"p":[["चतुर्विधा भजन्ते मां जनाः सुकृतिनोऽर्जुन।",0.0,4.47],["आर्तो जिज्ञासुरर्थार्थी ज्ञानी च भरतर्षभ॥",4.84,9.73]]},{"n":17,"d":9.45,"p":[["तेषां ज्ञानी नित्ययुक्त एकभक्तिर्विशिष्यते।",0.0,4.71],["प्रियो हि ज्ञानिनोऽत्यर्थ-महं स च मम प्रियः॥",5.04,9.45]]},{"n":18,"d":10.33,"p":[["उदाराः सर्व एवैते ज्ञानी त्वात्मैव मे मतम्।",0.0,4.99],["आस्थितः स हि युक्तात्मा मामेवानुत्तमां गतिम्॥",5.56,10.33]]},{"n":19,"d":9.67,"p":[["बहूनां जन्मनामन्ते ज्ञानवान्मां प्रपद्यते।",0.0,4.9],["वासुदेवः सर्वमिति स महात्मा सुदुर्लभः॥",5.33,9.67]]},{"n":20,"d":10.05,"p":[["कामैस्तैस्तैर्हृतज्ञानाः प्रपद्यन्तेऽन्यदेवताः।",0.0,4.97],["तं तं नियममास्थाय प्रकृत्या नियताः स्वया॥",5.32,10.05]]},{"n":21,"d":10.13,"p":[["यो यो यां यां तनुं भक्तः श्रद्धयार्चितुमिच्छति।",0.0,4.79],["तस्य तस्याचलां श्रद्धां तामेव विदधाम्यहम्॥",5.12,10.13]]},{"n":22,"d":9.67,"p":[["स तया श्रद्धया युक्तस्-तस्याराधनमीहते।",0.0,4.88],["लभते च ततः कामान् मयैव विहितान्हि तान्॥",5.29,9.67]]},{"n":23,"d":9.91,"p":[["अन्तवत्तु फलं तेषां तद्भवत्यल्पमेधसाम्।",0.0,4.77],["देवान्देवयजो यान्ति मद्भक्ता यान्ति मामपि॥",5.45,9.91]]},{"n":24,"d":9.97,"p":[["अव्यक्तं व्यक्तिमापन्नं मन्यन्ते मामबुद्धयः।",0.0,5.21],["परं भावमजानन्तो ममाव्ययमनुत्तमम्॥",5.56,9.97]]},{"n":25,"d":10.16,"p":[["नाहं प्रकाशः सर्वस्य योगमायासमावृतः।",0.0,5.11],["मूढोऽयं नाभिजानाति लोको मामजमव्ययम्॥",5.52,10.16]]},{"n":26,"d":9.29,"p":[["वेदाहं समतीतानि वर्तमानानि चार्जुन।",0.0,4.51],["भविष्याणि च भूतानि मां तु वेद न कश्चन॥",4.96,9.29]]},{"n":27,"d":9.33,"p":[["इच्छाद्वेषसमुत्थेन द्वन्द्वमोहेन भारत।",0.0,4.45],["सर्वभूतानि सम्मोहं सर्गे यान्ति परन्तप॥",4.84,9.33]]},{"n":28,"d":10.43,"p":[["येषां त्वन्तगतं पापं जनानां पुण्यकर्मणाम्।",0.0,5.1],["ते द्वन्द्वमोहनिर्मुक्ता भजन्ते मां दृढव्रताः॥",5.65,10.43]]},{"n":29,"d":9.65,"p":[["जरामरणमोक्षाय मामाश्रित्य यतन्ति ये।",0.0,4.45],["ते ब्रह्म तद्विदुः कृत्स्नमध्यात्मं कर्म चाखिलम्॥",4.8,9.65]]},{"n":30,"d":9.47,"p":[["साधिभूताधिदैवं मां साधियज्ञं च ये विदुः।",0.0,4.69],["प्रयाणकालेऽपि च मां ते विदुर्युक्तचेतसः॥",5.05,9.47]]}]}