{"ch":2,"v":[{"n":1,"d":9.21,"p":[["सञ्जय उवाच",0.04,1.33,"UV_sanjaya"],["तं तथा कृपयाविष्टमश्रुपूर्णाकुलेक्षणम्।",0.0,4.46],["विषीदन्तमिदं वाक्यमुवाच मधुसूदनः॥",5.04,9.21]]},{"n":2,"d":8.93,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["कुतस्त्वा कश्मलमिदं विषमे समुपस्थितम्।",0.0,4.16],["अनार्यजुष्टमस्वर्ग्य-मकीर्तिकरमर्जुन॥",4.68,8.93]]},{"n":3,"d":9.63,"p":[["क्लैब्यं मा स्म गमः पार्थ नैतत्त्वय्युपपद्यते।",0.0,4.56],["क्षुद्रं हृदयदौर्बल्यं त्यक्त्वोत्तिष्ठ परन्तप॥",4.89,9.63]]},{"n":4,"d":9.35,"p":[["अर्जुन उवाच",0.0,1.37,"UV_arjuna"],["कथं भीष्ममहं सङ्ख्ये द्रोणं च मधुसूदन।",0.0,4.57],["इषुभिः प्रति योत्स्यामि पूजार्हावरिसूदन॥",4.93,9.35]]},{"n":5,"d":15.13,"p":[["गुरूनहत्वा हि महानुभावान्",0.0,3.38],["श्रेयो भोक्तुं भैक्ष्यमपीह लोके।",3.97,7.57],["हत्वार्थकामांस्तु गुरूनिहैव",7.88,11.33],["भुञ्जीय भोगान्‍रुधिरप्रदिग्धान्॥",11.75,15.13]]},{"n":6,"d":15.05,"p":[["न चैतद्विद्मः कतरन्नो गरीयो-",0.0,3.47],["यद्वा जयेम यदि वा नो जयेयुः।",3.85,7.65],["यानेव हत्वा न जिजीविषाम-स्तेऽवस्थिताः प्रमुखे धार्तराष्ट्राः॥",8.04,15.05]]},{"n":7,"d":15.57,"p":[["कार्पण्यदोषोपहतस्वभावः",0.0,3.49],["पृच्छामि त्वां धर्मसम्मूढचेताः।",3.81,7.54],["यच्छ्रेयः स्यान्निश्चितं ब्रूहि तन्मे",7.88,11.73],["शिष्यस्तेऽहं शाधि मां त्वां प्रपन्नम्॥",12.07,15.57]]},{"n":8,"d":13.48,"p":[["न हि प्रपश्यामि ममापनुद्याद्",0.0,2.98],["यच्छोकमुच्छोषणमिन्द्रियाणाम्।",3.46,6.41],["अवाप्य भूमावसपत्नमृद्धं",6.94,10.01],["राज्यं सुराणामपि चाधिपत्यम्॥",10.62,13.48]]},{"n":9,"d":9.63,"p":[["सञ्जय उवाच",0.04,1.33,"UV_sanjaya"],["एवमुक्त्वा हृषीकेशं गुडाकेशः परन्तप।",0.0,4.71],["न योत्स्य इति गोविन्दमुक्त्वा तूष्णीं बभूव ह॥",5.09,9.63]]},{"n":10,"d":8.87,"p":[["तमुवाच हृषीकेशः प्रहसन्निव भारत।",0.0,4.03],["सेनयोरुभयोर्मध्ये विषीदन्तमिदं वचः॥",4.41,8.87]]},{"n":11,"d":9.95,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["अशोच्यानन्वशोचस्त्वं प्रज्ञावादांश्च भाषसे।",0.0,5.07],["गतासूनगतासूंश्च नानुशोचन्ति पण्डिताः॥",5.49,9.95]]},{"n":12,"d":9.21,"p":[["न त्वेवाहं जातु नासं न त्वं नेमे जनाधिपाः।",0.0,4.66],["न चैव न भविष्यामः सर्वे वयमतः परम्॥",5.04,9.21]]},{"n":13,"d":9.55,"p":[["देहिनोऽस्मिन्यथा देहे कौमारं यौवनं जरा।",0.0,4.71],["तथा देहान्तरप्राप्तिर्-धीरस्तत्र न मुह्यति॥",5.09,9.55]]},{"n":14,"d":10.09,"p":[["मात्रास्पर्शास्तु कौन्तेय शीतोष्णसुखदुःखदाः।",0.0,4.88],["आगमापायिनोऽनित्यास्-तांस्तितिक्षस्व भारत॥",5.24,10.09]]},{"n":15,"d":8.91,"p":[["यं हि न व्यथयन्त्येते पुरुषं पुरुषर्षभ।",0.0,4.2],["समदुःखसुखं धीरं सोऽमृतत्वाय कल्पते॥",4.57,8.91]]},{"n":16,"d":9.57,"p":[["नासतो विद्यते भावो नाभावो विद्यते सतः।",0.0,4.9],["उभयोरपि दृष्टोऽन्तस्-त्वनयोस्तत्त्वदर्शिभिः॥",5.24,9.57]]},{"n":17,"d":8.69,"p":[["अविनाशि तु तद्विद्धि येन सर्वमिदं ततम्।",0.0,4.0],["विनाशमव्ययस्यास्य न कश्चित्कर्तुमर्हति॥",4.56,8.69]]},{"n":18,"d":9.87,"p":[["अन्तवन्त इमे देहा नित्यस्योक्ताः शरीरिणः।",0.0,4.72],["अनाशिनोऽप्रमेयस्य तस्माद्युध्यस्व भारत॥",5.09,9.87]]},{"n":19,"d":9.65,"p":[["य एनं वेत्ति हन्तारं यश्चैनं मन्यते हतम्।",0.0,4.74],["उभौ तौ न विजानीतो नायं हन्ति न हन्यते॥",5.28,9.65]]},{"n":20,"d":14.23,"p":[["न जायते म्रियते वा कदाचिन्",0.0,3.02],["नायं भूत्वा भविता वा न भूयः।",3.46,6.99],["अजो नित्यः शाश्वतोऽयं पुराणो",7.33,10.8],["न हन्यते हन्यमाने शरीरे॥",11.13,14.23]]},{"n":21,"d":9.17,"p":[["वेदाविनाशिनं नित्यं य एनमजमव्ययम्।",0.0,4.39],["कथं स पुरुषः पार्थ कं घातयति हन्ति कम्॥",4.96,9.17]]},{"n":22,"d":12.96,"p":[["वासांसि जीर्णानि यथा विहाय",0.0,2.94],["नवानि गृह्णाति नरोऽपराणि।",3.3,6.27],["तथा शरीराणि विहाय जीर्णा-",6.62,9.69],["न्यन्यानि संयाति नवानि देही॥",10.06,12.96]]},{"n":23,"d":9.33,"p":[["नैनं छिन्दन्ति शस्त्राणि नैनं दहति पावकः।",0.0,4.51],["न चैनं क्लेदयन्त्यापो न शोषयति मारुतः॥",4.84,9.33]]},{"n":24,"d":9.51,"p":[["अच्छेद्योऽयमदाह्योऽयमक्लेद्योऽशोष्य एव च।",0.0,4.76],["नित्यः सर्वगतः स्थाणुरचलोऽयं सनातनः॥",5.13,9.51]]},{"n":25,"d":9.13,"p":[["अव्यक्तोऽयमचिन्त्योऽयमविकार्योऽयमुच्यते।",0.0,4.43],["तस्मादेवं विदित्वैनं नानुशोचितुमर्हसि॥",4.8,9.13]]},{"n":26,"d":9.39,"p":[["अथ चैनं नित्यजातं नित्यं वा मन्यसे मृतम्।",0.0,4.44],["तथापि त्वं महाबाहो नैवं शोचितुमर्हसि॥",5.01,9.