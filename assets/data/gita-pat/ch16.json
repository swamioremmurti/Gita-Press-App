{"ch":16,"v":[{"n":1,"d":9.53,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["अभयं सत्त्वसंशुद्धिर्-ज्ञानयोगव्यवस्थितिः।",0.0,4.44],["दानं दमश्च यज्ञश्च स्वाध्यायस्तप आर्जवम्॥",4.84,9.53]]},{"n":2,"d":9.83,"p":[["अहिंसा सत्यमक्रोधस्-त्यागः शान्तिरपैशुनम्।",0.0,4.81],["दया भूतेष्वलोलुप्त्वं मार्दवं ह्रीरचापलम्॥",4.78,9.83]]},{"n":3,"d":9.41,"p":[["तेजः क्षमा धृतिः शौचमद्रोहो नातिमानिता।",0.0,4.59],["भवन्ति सम्पदं दैवीमभिजातस्य भारत॥",5.04,9.41]]},{"n":4,"d":9.57,"p":[["दम्भो दर्पोऽभिमानश्च क्रोधः पारुष्यमेव च।",0.0,2.99],["अज्ञानं चाभिजातस्य पार्थ सम्पदमासुरीम्॥",4.53,9.57]]},{"n":5,"d":9.39,"p":[["दैवी सम्पद्विमोक्षाय निबन्धायासुरी मता।",0.0,4.37],["मा शुचः सम्पदं दैवीमभिजातोऽसि पाण्डव॥",4.69,9.39]]},{"n":6,"d":9.27,"p":[["द्वौ भूतसर्गौ लोकेऽस्मिन् दैव आसुर एव च।",0.0,4.76],["दैवो विस्तरशः प्रोक्त आसुरं पार्थ मे शृणु॥",4.73,9.27]]},{"n":7,"d":8.71,"p":[["प्रवृत्तिं च निवृत्तिं च जना न विदुरासुराः।",0.0,4.13],["न शौचं नापि चाचारो न सत्यं तेषु विद्यते॥",4.1,8.71]]},{"n":8,"d":9.11,"p":[["असत्यमप्रतिष्ठं ते जगदाहुरनीश्वरम्।",0.0,4.68],["अपरस्परसम्भूतं किमन्यत्कामहैतुकम्॥",4.65,9.11]]},{"n":9,"d":8.79,"p":[["एतां दृष्टिमवष्टभ्य नष्टात्मानोऽल्पबुद्धयः।",0.0,4.4],["प्रभवन्त्युग्रकर्माणः क्षयाय जगतोऽहिताः॥",4.37,8.79]]},{"n":10,"d":9.55,"p":[["काममाश्रित्य दुष्पूरं दम्भमानमदान्विताः।",0.0,4.73],["मोहाद्‍गृहीत्वासद्‍ग्राहान् प्रवर्तन्तेऽशुचिव्रताः॥",4.7,9.55]]},{"n":11,"d":8.83,"p":[["चिन्तामपरिमेयां च प्रलयान्तामुपाश्रिताः।",0.0,4.23],["कामोपभोगपरमा एतावदिति निश्चिताः॥",4.26,8.83]]},{"n":12,"d":10.0,"p":[["आशापाशशतैर्बद्धाः कामक्रोधपरायणाः।",0.0,5.11],["ईहन्ते कामभोगार्थ-मन्यायेनार्थसञ्चयान्॥",5.08,10.0]]},{"n":13,"d":8.47,"p":[["इदमद्य मया लब्धमिमं प्राप्स्ये मनोरथम्।",0.0,4.64],["इदमस्तीदमपि मे भविष्यति पुनर्धनम्॥",4.61,8.47]]},{"n":14,"d":8.39,"p":[["असौ मया हतः शत्रुुर्-हनिष्ये चापरानपि।",0.0,4.13],["ईश्वरोऽहमहं भोगी सिद्धोऽहं बलवान्सुखी॥",4.1,8.39]]},{"n":15,"d":8.77,"p":[["आढॺोऽभिजनवानस्मि कोऽन्योऽस्ति सदृशो मया।",0.0,2.75],["यक्ष्ये दास्यामि मोदिष्य इत्यज्ञानविमोहिताः॥",3.97,8.77]]},{"n":16,"d":8.51,"p":[["अनेकचित्तविभ्रान्ता मोहजालसमावृताः।",0.0,4.01],["प्रसक्ताः कामभोगेषु पतन्ति नरकेऽशुचौ॥",3.98,8.51]]},{"n":17,"d":9.41,"p":[["आत्मसम्भाविताः स्तब्धा धनमानमदान्विताः।",0.0,4.56],["यजन्ते नामयज्ञैस्ते दम्भेनाविधिपूर्वकम्॥",4.53,9.41]]},{"n":18,"d":9.29,"p":[["अहङ्कारं बलं दर्पं कामं क्रोधं च संश्रिताः।",0.0,4.67],["मामात्मपरदेहेषु प्रद्विषन्तोऽभ्यसूयकाः॥",4.64,9.29]]},{"n":19,"d":9.01,"p":[["तानहं द्विषतः क्रूरान् संसारेषु नराधमान्।",0.0,4.55],["क्षिपाम्यजस्रमशुभानासुरीष्वेव योनिषु॥",4.52,9.01]]},{"n":20,"d":9.21,"p":[["आसुरीं योनिमापन्ना मूढा जन्मनि जन्मनि।",0.0,4.52],["मामप्राप्यैव कौन्तेय ततो यान्त्यधमां गतिम्॥",4.49,9.21]]},{"n":21,"d":9.19,"p":[["त्रिविधं नरकस्येदं द्वारं नाशनमात्मनः।",0.0,4.08],["कामः क्रोधस्तथा लोभस्-तस्मादेतत्त्रयं त्यजेत्॥",4.1,9.19]]},{"n":22,"d":8.87,"p":[["एतैर्विमुक्तः कौन्तेय तमोद्वारैस्त्रिभिर्नरः।",0.0,4.42],["आचरत्यात्मनः श्रेयस्-ततो याति परां गतिम्॥",4.41,8.87]]},{"n":23,"d":8.63,"p":[["यः शास्त्रविधिमुत्सृज्य वर्तते कामकारतः।",0.0,3.08],["न स सिद्धिमवाप्नोति न सुखं न परां गतिम्॥",4.49,8.63]]},{"n":24,"d":9.17,"p":[["तस्माच्छास्त्रं प्रमाणं ते कार्याकार्यव्यवस्थितौ।",0.0,4.4],["ज्ञात्वा शास्त्रविधानोक्तं कर्म कर्तुमिहार्हसि॥",4.37,9.17]]}]}