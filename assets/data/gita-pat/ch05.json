{"ch":5,"v":[{"n":1,"d":9.47,"p":[["अर्जुन उवाच",0.0,1.37,"UV_arjuna"],["सन्न्यासं कर्मणां कृष्ण पुनर्योगं च शंससि।",0.0,4.61],["यच्छ्रेय एतयोरेकं तन्मे ब्रूहि सुनिश्चितम्॥",4.97,9.47]]},{"n":2,"d":9.31,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["सन्न्यासः कर्मयोगश्च निःश्रेयसकरावुभौ।",0.0,4.49],["तयोस्तु कर्मसन्न्यासात् कर्मयोगो विशिष्यते॥",4.85,9.31]]},{"n":3,"d":9.63,"p":[["ज्ञेयः स नित्यसन्न्यासी यो न द्वेष्टि न काङ्क्षति।",0.0,4.66],["निर्द्वन्द्वो हि महाबाहो सुखं बन्धात्प्रमुच्यते॥",5.01,9.63]]},{"n":4,"d":9.51,"p":[["साङ्ख्ययोगौ पृथग्बालाः प्रवदन्ति न पण्डिताः।",0.0,4.62],["एकमप्यास्थितः सम्यगुभयोर्विन्दते फलम्॥",5.01,9.51]]},{"n":5,"d":9.83,"p":[["यत्साङ्ख्यैः प्राप्यते स्थानं तद्योगैरपि गम्यते।",0.0,5.07],["एकं साङ्ख्यं च योगं च यः पश्यति स पश्यति॥",5.49,9.83]]},{"n":6,"d":9.49,"p":[["सन्न्यासस्तु महाबाहो दुःखमाप्तुुमयोगतः।",0.0,4.97],["योगयुक्तो मुनिर्ब्रह्म नचिरेणाधिगच्छति॥",5.36,9.49]]},{"n":7,"d":9.53,"p":[["योगयुक्तो विशुद्धात्मा विजितात्मा जितेन्द्रियः।",0.0,4.65],["सर्वभूतात्मभूतात्मा कुर्वन्नपि न लिप्यते॥",5.04,9.53]]},{"n":8,"d":9.81,"p":[["नैव किञ्चित्करोमीति युक्तो मन्येत तत्त्ववित्।",0.0,4.14],["पश्यञ्शृण्वन्स्पृशञ्जिघ्रन् नश्नन्गच्छन्स्वपञ्श्वसन्॥",4.69,9.81]]},{"n":9,"d":8.95,"p":[["प्रलपन्विसृजन्गृह्णन् नुन्मिषन्निमिषन्नपि।",0.0,4.0],["इन्द्रियाणीन्द्रियार्थेषु वर्तन्त इति धारयन्॥",4.38,8.95]]},{"n":10,"d":9.67,"p":[["ब्रह्मण्याधाय कर्माणि सङ्गं त्यक्त्वा करोति यः।",0.0,4.93],["लिप्यते न स पापेन पद्मपत्रमिवाम्भसा॥",5.33,9.67]]},{"n":11,"d":9.45,"p":[["कायेन मनसा बुद्‍ध्‍या केवलैरिन्द्रियैरपि।",0.0,4.41],["योगिनः कर्म कुर्वन्ति सङ्गं त्यक्त्वात्मशुद्धये॥",4.84,9.45]]},{"n":12,"d":9.93,"p":[["युक्तः कर्मफलं त्यक्त्वा शान्तिमाप्नोति नैष्ठिकीम्।",0.0,4.91],["अयुक्तः कामकारेण फले सक्तो निबध्यते॥",5.48,9.93]]},{"n":13,"d":9.67,"p":[["सर्वकर्माणि मनसा सन्न्यस्यास्ते सुखं वशी।",0.01,4.58],["नवद्वारे पुरे देही नैव कुर्वन्न कारयन्॥",4.93,9.67]]},{"n":14,"d":9.17,"p":[["न कर्तृत्वं न कर्माणि लोकस्य सृजति प्रभुः।",0.0,4.45],["न कर्मफलसंयोगं स्वभावस्तु प्रवर्तते॥",4.8,9.17]]},{"n":15,"d":9.53,"p":[["नादत्ते कस्यचित्पापं न चैव सुकृतं विभुः।",0.0,4.53],["अज्ञानेनावृतं ज्ञानं तेन मुह्यन्ति जन्तवः॥",4.88,9.53]]},{"n":16,"d":9.67,"p":[["ज्ञानेन तु तदज्ञानं येषां नाशितमात्मनः।",0.0,4.78],["तेषामादित्यवज्ज्ञानं प्रकाशयति तत्परम्॥",5.13,9.67]]},{"n":17,"d":9.97,"p":[["तद्‍बुद्धयस्तदात्मानस्-तन्निष्ठास्तत्परायणाः।",0.0,4.94],["गच्छन्त्यपुनरावृत्तिं ज्ञाननिर्धूतकल्मषाः॥",5.36,9.97]]},{"n":18,"d":9.15,"p":[["विद्याविनयसम्पन्ने ब्राह्मणे गवि हस्तिनि।",0.0,4.42],["शुनि चैव श्वपाके च पण्डिताः समदर्शिनः॥",4.77,9.15]]},{"n":19,"d":10.11,"p":[["इहैव तैर्जितः सर्गो येषां साम्ये स्थितं मनः।",0.0,5.08],["निर्दोषं हि समं ब्रह्म तस्माद्‍ब्रह्मणि ते स्थिताः॥",5.49,10.11]]},{"n":20,"d":9.69,"p":[["न प्रहृष्येत्प्रियं प्राप्य नोद्विजेत्प्राप्य चाप्रियम्।",0.0,4.86],["स्थिरबुद्धिरसम्मूढो ब्रह्मविद्‍ब्रह्मणि स्थितः॥",5.32,9.69]]},{"n":21,"d":9.81,"p":[["बाह्यस्पर्शेष्वसक्तात्मा विन्दत्यात्मनि यत्सुखम्।",0.0,4.85],["स ब्रह्मयोगयुक्तात्मा सुखमक्षयमश्नुते॥",5.4,9.81]]},{"n":22,"d":9.39,"p":[["ये हि संस्पर्शजा भोगा दुःखयोनय एव ते।",0.0,4.57],["आद्यन्तवन्तः कौन्तेय न तेषु रमते बुधः॥",4.93,9.39]]},{"n":23,"d":10.15,"p":[["शक्नोतीहैव यः सोढुं प्राक्शरीरविमोक्षणात्।",0.0,4.84],["कामक्रोधोद्भवं वेगं स युक्तः स सुखी नरः॥",5.41,10.15]]},{"n":24,"d":9.75,"p":[["योऽन्तःसुखोऽन्तरारामस्-तथान्तर्ज्योतिरेव यः।",0.0,4.89],["स योगी ब्रह्मनिर्वाणं ब्रह्मभूतोऽधिगच्छति॥",5.25,9.75]]},{"n":25,"d":9.71,"p":[["लभन्ते ब्रह्मनिर्वाण-मृषयः क्षीणकल्मषाः।",0.0,4.56],["छिन्नद्वैधा यतात्मानः सर्वभूतहिते रताः॥",4.97,9.71]]},{"n":26,"d":10.07,"p":[["कामक्रोधवियुक्तानां यतीनां यतचेतसाम्।",0.0,4.88],["अभितो ब्रह्मनिर्वाणं वर्तते विदितात्मनाम्॥",5.45,10.07]]},{"n":27,"d":10.56,"p":[["स्पर्शान्कृत्वा बहिर्बाह्यांश्-चक्षुश्चैवान्तरे भ्रुवोः।",0.01,5.27],["प्राणापानौ समौ कृत्वा नासाभ्यन्तरचारिणौ॥",5.6,10.56]]},{"n":28,"d":9.31,"p":[["यतेन्द्रियमनोबुद्धिर्-मुनिर्मोक्षपरायणः।",0.0,4.43],["विगतेच्छाभयक्रोधो यः सदा मुक्त एव सः॥",4.81,9.31]]},{"n":29,"d":9.99,"p":[["भोक्तारं यज्ञतपसां सर्वलोकमहेश्वरम्।",0.0,4.63],["सुहृदं सर्वभूतानां ज्ञात्वा मां शान्तिमृच्छति॥",5.13,9.99]]}]}