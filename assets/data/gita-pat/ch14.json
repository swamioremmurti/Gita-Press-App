{"ch":14,"v":[{"n":1,"d":9.17,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["परं भूयः प्रवक्ष्यामि ज्ञानानां ज्ञानमुत्तमम्।",0.0,3.91],["यज्ज्ञात्वा मुनयः सर्वे परां सिद्धिमितो गताः॥",4.33,9.17]]},{"n":2,"d":8.81,"p":[["इदं ज्ञानमुपाश्रित्य मम साधर्म्यमागताः।",0.0,4.47],["सर्गेऽपि नोपजायन्ते प्रलये न व्यथन्ति च॥",4.44,8.81]]},{"n":3,"d":9.31,"p":[["मम योनिर्महद्‍ब्रह्म तस्मिन्गर्भं दधाम्यहम्।",0.0,4.84],["सम्भवः सर्वभूतानां ततो भवति भारत॥",4.81,9.31]]},{"n":4,"d":9.69,"p":[["सर्वयोनिषु कौन्तेय मूर्तयः सम्भवन्ति याः।",0.01,4.76],["तासां ब्रह्म महद्योनिरहं बीजप्रदः पिता॥",4.73,9.69]]},{"n":5,"d":8.63,"p":[["सत्त्वं रजस्तम इति गुणाः प्रकृतिसम्भवाः।",0.0,4.09],["निबध्नन्ति महाबाहो देहे देहिनमव्ययम्॥",4.06,8.63]]},{"n":6,"d":8.75,"p":[["तत्र सत्त्वं निर्मलत्वात् प्रकाशकमनामयम्।",0.0,4.05],["सुखसङ्गेन बध्नाति ज्ञानसङ्गेन चानघ॥",4.02,8.75]]},{"n":7,"d":9.27,"p":[["रजो रागात्मकं विद्धि तृष्णासङ्गसमुद्भवम्।",0.0,4.64],["तन्निबध्नाति कौन्तेय कर्मसङ्गेन देहिनम्॥",4.61,9.27]]},{"n":8,"d":9.27,"p":[["तमस्त्वज्ञानजं विद्धि मोहनं सर्वदेहिनाम्।",0.0,4.61],["प्रमादालस्यनिद्राभिस्-तन्निबध्नाति भारत॥",4.58,9.27]]},{"n":9,"d":8.75,"p":[["सत्त्वं सुखे सञ्जयति रजः कर्मणि भारत।",0.0,4.44],["ज्ञानमावृत्य तु तमः प्रमादे सञ्जयत्युत॥",4.41,8.75]]},{"n":10,"d":8.73,"p":[["रजस्तमश्चाभिभूय सत्त्वं भवति भारत।",0.0,2.9],["रजः सत्त्वं तमश्चैव तमः सत्त्वं रजस्तथा॥",4.4,8.73]]},{"n":11,"d":9.25,"p":[["सर्वद्वारेषु देहेऽस्मिन् प्रकाश उपजायते।",0.0,4.16],["ज्ञानं यदा तदा विद्याद् विवृद्धं सत्त्वमित्युत॥",4.13,9.25]]},{"n":12,"d":9.47,"p":[["लोभः प्रवृत्तिरारम्भः कर्मणामशमः स्पृहा।",0.0,4.92],["रजस्येतानि जायन्ते विवृद्धे भरतर्षभ॥",4.89,9.47]]},{"n":13,"d":8.99,"p":[["अप्रकाशोऽप्रवृत्तिश्च प्रमादो मोह एव च।",0.0,4.25],["तमस्येतानि जायन्ते विवृद्धे कुरुनन्दन॥",4.22,8.99]]},{"n":14,"d":8.93,"p":[["यदा सत्त्वे प्रवृद्धे तु प्रलयं याति देहभृत्।",0.0,3.16],["तदोत्तमविदां लोकानमलान्प्रतिपद्यते॥",4.68,8.93]]},{"n":15,"d":8.45,"p":[["रजसि प्रलयं गत्वा कर्मसङ्गिषु जायते।",0.0,4.35],["तथा प्रलीनस्तमसि मूढयोनिषु जायते॥",4.32,8.45]]},{"n":16,"d":9.07,"p":[["कर्मणः सुकृतस्याहुः सात्त्विकं निर्मलं फलम्।",0.0,4.84],["रजसस्तु फलं दुःखमज्ञानं तमसः फलम्॥",4.81,9.07]]},{"n":17,"d":9.05,"p":[["सत्त्वात्सञ्जायते ज्ञानं रजसो लोभ एव च।",0.0,4.79],["प्रमादमोहौ तमसो भवतोऽज्ञानमेव च॥",4.76,9.05]]},{"n":18,"d":9.51,"p":[["ऊर्ध्वं गच्छन्ति सत्त्वस्था मध्ये तिष्ठन्ति राजसाः।",0.0,5.24],["जघन्यगुणवृत्तिस्था अधो गच्छन्ति तामसाः॥",5.21,9.51]]},{"n":19,"d":9.21,"p":[["नान्यं गुणेभ्यः कर्तारं यदा द्रष्टानुपश्यति।",0.0,4.79],["गुणेभ्यश्च परं वेत्ति मद्भावं सोऽधिगच्छति॥",4.76,9.21]]},{"n":20,"d":9.27,"p":[["गुणानेतानतीत्य त्रीन् देही देहसमुद्भवान्।",0.0,4.61],["जन्ममृत्युजरादुःखैर्-विमुक्तोऽमृतमश्नुते॥",4.58,9.27]]},{"n":21,"d":9.25,"p":[["अर्जुन उवाच",0.0,1.37,"UV_arjuna"],["कैर्लिङ्गैस्त्रीन्गुणानेतानतीतो भवति प्रभो।",0.0,3.4],["किमाचारः कथं चैतांस्-त्रीन्गुणानतिवर्तते॥",4.57,9.25]]},{"n":22,"d":8.43,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["प्रकाशं च प्रवृत्तिं च मोहमेव च पाण्डव।",0.0,4.09],["न द्वेष्टि सम्प्रवृत्तानि न निवृत्तानि काङ्क्षति॥",4.06,8.43]]},{"n":23,"d":8.43,"p":[["उदासीनवदासीनो गुणैर्यो न विचाल्यते।",0.0,4.13],["गुणा वर्तन्त इत्येव योऽवतिष्ठति नेङ्गते॥",4.1,8.43]]},{"n":24,"d":9.21,"p":[["समदुःखसुखः स्वस्थः समलोष्टाश्मकाञ्चनः।",0.0,4.71],["तुल्यप्रियाप्रियो धीरस्-तुल्यनिन्दात्मसंस्तुतिः॥",4.68,9.21]]},{"n":25,"d":8.73,"p":[["मानापमानयोस्तुल्यस्-तुल्यो मित्रारिपक्षयोः।",0.0,3.75],["सर्वारम्भपरित्यागी गुणातीतः स उच्यते॥",4.32,8.73]]},{"n":26,"d":9.61,"p":[["मां च योऽव्यभिचारेण भक्तियोगेन सेवते।",0.0,4.87],["स गुणान्समतीत्यैतान् ब्रह्मभूयाय कल्पते॥",4.84,9.61]]},{"n":27,"d":8.67,"p":[["ब्रह्मणो हि प्रतिष्ठाहममृतस्याव्ययस्य च।",0.0,2.81],["शाश्वतस्य च धर्मस्य सुखस्यैकान्तिकस्य च॥",4.14,8.67]]}]}