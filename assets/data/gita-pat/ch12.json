{"ch":12,"v":[{"n":1,"d":9.65,"p":[["अर्जुन उवाच",0.0,1.37,"UV_arjuna"],["एवं सततयुक्ता ये भक्तास्त्वां पर्युपासते।",0.0,3.38],["ये चाप्यक्षरमव्यक्तं तेषां के योगवित्तमाः॥",4.8,9.65]]},{"n":2,"d":9.25,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["मय्यावेश्य मनो ये मां नित्ययुक्ता उपासते।",0.0,4.56],["श्रद्धया परयोपेतास्-ते मे युक्ततमा मताः॥",4.53,9.25]]},{"n":3,"d":8.95,"p":[["ये त्वक्षरमनिर्देश्य-मव्यक्तं पर्युपासते।",0.0,3.15],["सर्वत्रगमचिन्त्यं च कूटस्थमचलं ध्रुवम्॥",4.77,8.95]]},{"n":4,"d":9.25,"p":[["सन्नियम्येन्द्रियग्रामं सर्वत्र समबुद्धयः।",0.0,4.52],["ते प्राप्नुवन्ति मामेव सर्वभूतहिते रताः॥",4.49,9.25]]},{"n":5,"d":9.93,"p":[["क्लेशोऽधिकतरस्तेषामव्यक्तासक्तचेतसाम्।",0.0,4.96],["अव्यक्ता हि गतिर्दुःखं देहवद्भिरवाप्यते॥",5.48,9.93]]},{"n":6,"d":8.61,"p":[["ये तु सर्वाणि कर्माणि मयि सन्न्यस्य मत्पराः।",0.0,4.28],["अनन्येनैव योगेन मां ध्यायन्त उपासते॥",4.25,8.61]]},{"n":7,"d":9.41,"p":[["तेषामहं समुद्धर्ता मृत्युसंसारसागरात्।",0.0,4.71],["भवामि नचिरात्पार्थ मय्यावेशितचेतसाम्॥",4.68,9.41]]},{"n":8,"d":9.07,"p":[["मय्येव मन आधत्स्व मयि बुद्धिं निवेशय।",0.0,4.52],["निवसिष्यसि मय्येव अत ऊर्ध्वं न संशयः॥",4.49,9.07]]},{"n":9,"d":8.59,"p":[["अथ चित्तं समाधातुं न शक्नोषि मयि स्थिरम्।",0.0,4.25],["अभ्यासयोगेन ततो मामिच्छाप्तुं धनञ्जय॥",4.22,8.59]]},{"n":10,"d":8.47,"p":[["अभ्यासेऽप्यसमर्थोऽसि मत्कर्मपरमो भव।",0.0,4.6],["मदर्थमपि कर्माणि कुर्वन्सिद्धिमवाप्स्यसि॥",4.57,8.47]]},{"n":11,"d":8.99,"p":[["अथैतदप्यशक्तोऽसि कर्तुं मद्योगमाश्रितः।",0.0,4.64],["सर्वकर्मफलत्यागं ततः कुरु यतात्मवान्॥",4.61,8.99]]},{"n":12,"d":10.11,"p":[["श्रेयो हि ज्ञानमभ्यासाज्-ज्ञानाद्‍ध्‍यानं विशिष्यते।",0.0,3.99],["ध्यानात्कर्मफलत्यागस्-त्यागाच्छान्तिरनन्तरम्॥",5.29,10.11]]},{"n":13,"d":8.59,"p":[["अद्वेष्टा सर्वभूतानां मैत्रः करुण एव च।",0.0,4.72],["निर्ममो निरहङ्कारः समदुःखसुखः क्षमी॥",4.69,8.59]]},{"n":14,"d":9.65,"p":[["सन्तुष्टः सततं योगी यतात्मा दृढनिश्चयः।",0.01,4.91],["मय्यर्पितमनोबुद्धिर्-यो मद्भक्तः स मे प्रियः॥",4.88,9.65]]},{"n":15,"d":9.85,"p":[["यस्मान्नोद्विजते लोको लोकान्नोद्विजते च यः।",0.0,4.64],["हर्षामर्षभयोद्वेगैर्-मुक्तो यः स च मे प्रियः॥",4.61,9.85]]},{"n":16,"d":9.57,"p":[["अनपेक्षः शुचिर्दक्ष उदासीनो गतव्यथः।",0.0,4.4],["सर्वारम्भपरित्यागी यो मद्भक्तः स मे प्रियः॥",4.37,9.57]]},{"n":17,"d":9.35,"p":[["यो न हृष्यति न द्वेष्टि न शोचति न काङ्क्षति।",0.0,4.33],["शुभाशुभपरित्यागी भक्तिमान्यः स मे प्रियः॥",4.3,9.35]]},{"n":18,"d":9.41,"p":[["समः शत्रौ च मित्रे च तथा मानापमानयोः।",0.01,4.91],["शीतोष्णसुखदुःखेषु समः सङ्गविवर्जितः॥",4.88,9.41]]},{"n":19,"d":8.93,"p":[["तुल्यनिन्दास्तुतिर्मौनी सन्तुष्टो येन केनचित्।",0.0,4.75],["अनिकेतः स्थिरमतिर्-भक्तिमान्मे प्रियो नरः॥",4.72,8.93]]},{"n":20,"d":9.31,"p":[["ये तु धर्म्यामृतमिदं यथोक्तं पर्युपासते।",0.0,4.33],["श्रद्दधाना मत्परमा भक्तास्तेऽतीव मे प्रियाः॥",4.3,9.31]]}]}