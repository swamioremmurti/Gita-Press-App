{"ch":13,"v":[{"n":1,"d":9.63,"p":[["अर्जुन उवाच",0.0,1.37,"UV_arjuna"],["प्रकृतिं पुरुषं चैव क्षेत्रं क्षेत्रज्ञमेव च ।",0.0,4.58],["एतद्वेदितुमिच्छामि ज्ञानं ज्ञेयं च केशव ॥",4.97,9.63]]},{"n":2,"d":9.29,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["इदं शरीरं कौन्तेय क्षेत्रमित्यभिधीयते।",0.0,2.95],["एतद्यो वेत्ति तं प्राहुः क्षेत्रज्ञ इति तद्विदः॥",4.09,9.29]]},{"n":3,"d":10.37,"p":[["क्षेत्रज्ञं चापि मां विद्धि सर्वक्षेत्रेषु भारत।",0.0,5.16],["क्षेत्रक्षेत्रज्ञयोर्ज्ञानं यत्तज्ज्ञानं मतं मम॥",5.48,10.37]]},{"n":4,"d":8.45,"p":[["तत्क्षेत्रं यच्च यादृक्च यद्विकारि यतश्च यत्।",0.0,4.35],["स च यो यत्प्रभावश्च तत्समासेन मे शृणु॥",4.32,8.45]]},{"n":5,"d":8.79,"p":[["ऋषिभिर्बहुधा गीतं छन्दोभिर्विविधैः पृथक्।",0.0,4.6],["ब्रह्मसूत्रपदैश्चैव हेतुमद्भिर्विनिश्चितैः॥",4.57,8.79]]},{"n":6,"d":8.39,"p":[["महाभूतान्यहङ्कारो बुद्धिरव्यक्तमेव च।",0.0,3.35],["इन्द्रियाणि दशैकं च पञ्च चेन्द्रियगोचराः॥",4.25,8.39]]},{"n":7,"d":9.19,"p":[["इच्छा द्वेषः सुखं दुःखं सङ्घातश्चेतना धृतिः।",0.0,5.12],["एतत्क्षेत्रं समासेन सविकारमुदाहृतम्॥",5.09,9.19]]},{"n":8,"d":8.89,"p":[["अमानित्वमदम्भित्वमहिंसा क्षान्तिरार्जवम्।",0.0,4.28],["आचार्योपासनं शौचं स्थैर्यमात्मविनिग्रहः॥",4.25,8.89]]},{"n":9,"d":8.61,"p":[["इन्द्रियार्थेषु वैराग्यमनहङ्कार एव च।",0.0,4.24],["जन्ममृत्युजराव्याधिदुःखदोषानुदर्शनम्॥",4.21,8.61]]},{"n":10,"d":8.25,"p":[["असक्तिरनभिष्वङ्गः पुत्रदारगृहादिषु।",0.0,4.15],["नित्यं च समचित्तत्वमिष्टानिष्टोपपत्तिषु॥",4.12,8.25]]},{"n":11,"d":8.27,"p":[["मयि चानन्ययोगेन भक्तिरव्यभिचारिणी।",0.0,4.52],["विविक्तदेशसेवित्वमरतिर्जनसंसदि॥",4.49,8.27]]},{"n":12,"d":9.55,"p":[["अध्यात्मज्ञाननित्यत्वं तत्त्वज्ञानार्थदर्शनम्।",0.0,5.28],["एतज्ज्ञानमिति प्रोक्तमज्ञानं यदतोऽन्यथा॥",5.25,9.55]]},{"n":13,"d":9.73,"p":[["ज्ञेयं यत्तत्प्रवक्ष्यामि यज्ज्ञात्वामृतमश्नुते।",0.0,5.31],["अनादिमत्परं ब्रह्म न सत्तन्नासदुच्यते॥",5.28,9.73]]},{"n":14,"d":8.31,"p":[["सर्वतःपाणिपादं तत् सर्वतोऽक्षिशिरोमुखम्।",0.0,4.16],["सर्वतःश्रुतिमल्लोके सर्वमावृत्य तिष्ठति॥",4.13,8.31]]},{"n":15,"d":8.73,"p":[["सर्वेन्द्रियगुणाभासं सर्वेन्द्रियविवर्जितम्।",0.0,4.51],["असक्तं सर्वभृच्चैव निर्गुणं गुणभोक्तृ च॥",4.48,8.73]]},{"n":16,"d":8.85,"p":[["बहिरन्तश्च भूतानामचरं चरमेव च।",0.0,2.94],["सूक्ष्मत्वात्तदविज्ञेयं दूरस्थं चान्तिके च तत्॥",4.21,8.85]]},{"n":17,"d":8.61,"p":[["अविभक्तं च भूतेषु विभक्तमिव च स्थितम्।",0.0,2.44],["भूतभर्तृ च तज्ज्ञेयं ग्रसिष्णु प्रभविष्णु च॥",3.85,8.61]]},{"n":18,"d":8.87,"p":[["ज्योतिषामपि तज्ज्योतिस्-तमसः परमुच्यते।",0.0,2.74],["ज्ञानं ज्ञेयं ज्ञानगम्यं हृदि सर्वस्य विष्ठितम्॥",4.02,8.87]]},{"n":19,"d":9.77,"p":[["इति क्षेत्रं तथा ज्ञानं ज्ञेयं चोक्तं समासतः।",0.0,3.75],["मद्भक्त एतद्विज्ञाय मद्भावायोपपद्यते॥",4.88,9.77]]},{"n":20,"d":8.53,"p":[["प्रकृतिं पुरुषं चैव विद्‍ध्‍यनादी उभावपि।",0.0,2.94],["विकारांश्च गुणांश्चैव विद्धि प्रकृतिसम्भवान्॥",3.89,8.53]]},{"n":21,"d":8.85,"p":[["कार्यकरणकर्तृत्वे हेतुः प्रकृतिरुच्यते।",0.0,2.74],["पुरुषः सुखदुःखानां भोक्तृत्वे हेतुरुच्यते॥",4.33,8.85]]},{"n":22,"d":8.21,"p":[["पुरुषः प्रकृतिस्थो हि भुङ्‍क्ते प्रकृतिजान्गुणान्।",0.0,4.23],["कारणं गुणसङ्गोऽस्य सदसद्योनिजन्मसु॥",4.2,8.21]]},{"n":23,"d":9.27,"p":[["उपद्रष्टानुमन्ता च भर्ता भोक्ता महेश्वरः।",0.0,4.37],["परमात्मेति चाप्युक्तो देहेऽस्मिन्पुरुषः परः॥",4.34,9.27]]},{"n":24,"d":8.91,"p":[["य एवं वेत्ति पुरुषं प्रकृतिं च गुणैः सह।",0.0,4.37],["सर्वथा वर्तमानोऽपि न स भूयोऽभिजायते॥",4.34,8.91]]},{"n":25,"d":9.21,"p":[["ध्यानेनात्मनि पश्यन्ति केचिदात्मानमात्मना।",0.0,4.04],["अन्ये साङ्ख्येन योगेन कर्मयोगेन चापरे॥",4.56,9.21]]},{"n":26,"d":9.21,"p":[["अन्ये त्वेवमजानन्तः श्रुत्वान्येभ्य उपासते।",0.0,4.91],["तेऽपि चातितरन्त्येव मृत्युं श्रुतिपरायणाः॥",4.88,9.21]]},{"n":27,"d":9.39,"p":[["यावत्सञ्जायते किञ्चित् सत्त्वं स्थावरजङ्गमम्।",0.0,4.84],["क्षेत्रक्षेत्रज्ञसंयोगात् तद्विद्धि भरतर्षभ॥",4.81,9.39]]},{"n":28,"d":8.65,"p":[["समं सर्वेषु भूतेषु तिष्ठन्तं परमेश्वरम्।",0.0,3.21],["विनश्यत्स्वविनश्यन्तं यः पश्यति स पश्यति॥",4.64,8.65]]},{"n":29,"d":8.41,"p":[["समं पश्यन्हि सर्वत्र समवस्थितमीश्वरम्।",0.0,2.5],["न हिनस्त्यात्मनात्मानं ततो याति परां गतिम्॥",3.57,8.41]]},{"n":30,"d":8.43,"p":[["प्रकृत्यैव च कर्माणि क्रियमाणानि सर्वशः।",0.0,4.05],["यः पश्यति तथात्मानमकर्तारं स पश्यति॥",4.02,8.43]]},{"n":31,"d":8.51,"p":[["यदा भूतपृथग्भावमेकस्थमनुपश्यति।",0.0,2.7],["तत एव च विस्तारं ब्रह्म सम्पद्यते तदा॥",4.25,8.51]]},{"n":32,"d":8.41,"p":[["अनादित्वान्निर्गुणत्वात् परमात्मायमव्ययः।",0.0,3.04],["शरीरस्थोऽपि कौन्तेय न करोति न लिप्यते॥",4.28,8.41]]},{"n":33,"d":9.35,"p":[["यथा सर्वगतं सौक्ष्म्यादाकाशं नोपलिप्यते।",0.0,4.08],["सर्वत्रावस्थितो देहे तथात्मा नोपलिप्यते॥",4.54,9.35]]},{"n":34,"d":9.69,"p":[["यथा प्रकाशयत्येकः कृत्स्नं लोकमिमं रविः।",0.0,4.87],["क्षेत्रं क्षेत्री तथा कृत्स्नं प्रकाशयति भारत॥",4.84,9.69]]},{"n":35,"d":9.51,"p":[["क्षेत्रक्षेत्रज्ञयोरेवमन्तरं ज्ञानचक्षुषा।",0.0,4.96],["भूतप्रकृतिमोक्षं च ये विदुर्यान्ति ते परम्॥",4.93,9.51]]}]}