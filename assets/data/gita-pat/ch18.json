{"ch":18,"v":[{"n":1,"d":9.61,"p":[["अर्जुन उवाच",0.0,1.37,"UV_arjuna"],["सन्न्यासस्य महाबाहो तत्त्वमिच्छामि वेदितुम्।",0.0,4.82],["त्यागस्य च हृषीकेश पृथक्‍केशिनिषूदन॥",5.32,9.61]]},{"n":2,"d":9.99,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["काम्यानां कर्मणां न्यासं सन्न्यासं कवयो विदुः।",0.0,4.93],["सर्वकर्मफलत्यागं प्राहुस्त्यागं विचक्षणाः॥",5.33,9.99]]},{"n":3,"d":9.47,"p":[["त्याज्यं दोषवदित्येके कर्म प्राहुर्मनीषिणः।",0.0,4.93],["यज्ञदानतपःकर्म न त्याज्यमिति चापरे॥",5.29,9.47]]},{"n":4,"d":8.95,"p":[["निश्चयं शृणु मे तत्र त्यागे भरतसत्तम।",0.0,4.45],["त्यागो हि पुरुषव्याघ्र त्रिविधः सम्प्रकीर्तितः॥",4.42,8.95]]},{"n":5,"d":8.99,"p":[["यज्ञदानतपःकर्म न त्याज्यं कार्यमेव तत्।",0.0,4.08],["यज्ञो दानं तपश्चैव पावनानि मनीषिणाम्॥",4.42,8.99]]},{"n":6,"d":9.49,"p":[["एतान्यपि तु कर्माणि सङ्गं त्यक्त्वा फलानि च।",0.0,4.64],["कर्तव्यानीति मे पार्थ निश्चितं मतमुत्तमम्॥",4.61,9.49]]},{"n":7,"d":9.61,"p":[["नियतस्य तु सन्न्यासः कर्मणो नोपपद्यते।",0.0,4.79],["मोहात्तस्य परित्यागस्-तामसः परिकीर्तितः॥",4.76,9.61]]},{"n":8,"d":8.61,"p":[["दुःखमित्येव यत्कर्म कायक्लेशभयात्त्यजेत्।",0.0,3.44],["स कृत्वा राजसं त्यागं नैव त्यागफलं लभेत्॥",3.93,8.61]]},{"n":9,"d":9.33,"p":[["कार्यमित्येव यत्कर्म नियतं क्रियतेऽर्जुन।",0.0,2.88],["सङ्गं त्यक्त्वा फलं चैव स त्यागः सात्त्विको मतः॥",4.33,9.33]]},{"n":10,"d":9.57,"p":[["न द्वेष्ट्यकुशलं कर्म कुशले नानुषज्जते।",0.0,4.4],["त्यागी सत्त्वसमाविष्टो मेधावी छिन्नसंशयः॥",4.37,9.57]]},{"n":11,"d":9.03,"p":[["न हि देहभृता शक्यं त्यक्तुं कर्माण्यशेषतः।",0.0,4.52],["यस्तु कर्मफलत्यागी स त्यागीत्यभिधीयते॥",4.49,9.03]]},{"n":12,"d":8.61,"p":[["अनिष्टमिष्टं मिश्रं च त्रिविधं कर्मणः फलम्।",0.0,2.77],["भवत्यत्यागिनां प्रेत्य न तु सन्न्यासिनां क्वचित्॥",4.13,8.61]]},{"n":13,"d":9.59,"p":[["पञ्चैतानि महाबाहो कारणानि निबोध मे।",0.0,4.21],["साङ्ख्ये कृतान्ते प्रोक्तानि सिद्धये सर्वकर्मणाम्॥",4.18,9.59]]},{"n":14,"d":8.89,"p":[["अधिष्ठानं तथा कर्ता करणं च पृथग्विधम्।",0.0,2.91],["विविधाश्च पृथक्चेष्टा दैवं चैवात्र पञ्चमम्॥",4.25,8.89]]},{"n":15,"d":9.51,"p":[["शरीरवाङ्मनोभिर्यत् कर्म प्रारभते नरः।",0.01,4.37],["न्याय्यं वा विपरीतं वा पञ्चैते तस्य हेतवः॥",4.34,9.51]]},{"n":16,"d":8.67,"p":[["तत्रैवं सति कर्तारमात्मानं केवलं तु यः।",0.0,3.17],["पश्यत्यकृतबुद्धित्वान् न स पश्यति दुर्मतिः॥",4.57,8.67]]},{"n":17,"d":8.67,"p":[["यस्य नाहङ्कृतो भावो बुद्धिर्यस्य न लिप्यते।",0.0,4.6],["हत्वापि स इमाँल्लोकान् न हन्ति न निबध्यते॥",4.57,8.67]]},{"n":18,"d":9.23,"p":[["ज्ञानं ज्ञेयं परिज्ञाता त्रिविधा कर्मचोदना।",0.0,4.84],["करणं कर्म कर्तेति त्रिविधः कर्मसङ्ग्रहः॥",4.81,9.23]]},{"n":19,"d":8.71,"p":[["ज्ञानं कर्म च कर्ता च त्रिधैव गुणभेदतः।",0.0,4.6],["प्रोच्यते गुणसङ्ख्याने यथावच्छृणु तान्यपि॥",4.57,8.71]]},{"n":20,"d":8.97,"p":[["सर्वभूतेषु येनैकं भावमव्ययमीक्षते।",0.0,4.51],["अविभक्तं विभक्तेषु तज्ज्ञानं विद्धि सात्त्विकम्॥",4.48,8.97]]},{"n":21,"d":9.71,"p":[["पृथक्त्वेन तु यज्ज्ञानं नानाभावान्पृथग्विधान्।",0.0,4.92],["वेत्ति सर्वेषु भूतेषु तज्ज्ञानं विद्धि राजसम्॥",4.89,9.71]]},{"n":22,"d":8.51,"p":[["यत्तु कृत्स्नवदेकस्मिन् कार्ये सक्तमहैतुकम्।",0.0,4.32],["अतत्त्वार्थवदल्पं च तत्तामसमुदाहृतम्॥",4.29,8.51]]},{"n":23,"d":8.35,"p":[["नियतं सङ्गरहितमरागद्वेषतः कृतम्।",0.0,3.73],["अफलप्रेप्सुना कर्म यत्तत्सात्त्विकमुच्यते॥",3.7,8.35]]},{"n":24,"d":8.53,"p":[["यत्तु कामेप्सुना कर्म साहङ्कारेण वा पुनः।",0.0,4.3],["क्रियते बहुलायासं तद्राजसमुदाहृतम्॥",4.28,8.53]]},{"n":25,"d":8.45,"p":[["अनुबन्धं क्षयं हिंसामनवेक्ष्य च पौरुषम्।",0.0,3.84],["मोहादारभ्यते कर्म यत्तत्तामसमुच्यते॥",3.81,8.45]]},{"n":26,"d":8.85,"p":[["मुक्तसङ्गोऽनहंवादी धृत्युत्साहसमन्वितः।",0.0,4.36],["सिद्‍ध्‍यसिद्‍ध्‍योर्निर्विकारः कर्ता सात्त्विक उच्यते॥",4.33,8.85]]},{"n":27,"d":9.33,"p":[["रागी कर्मफलप्रेप्सुर्-लुब्धो हिंसात्मकोऽशुचिः।",0.0,3.44],["हर्षशोकान्वितः कर्ता राजसः परिकीर्तितः॥",4.57,9.33]]},{"n":28,"d":8.59,"p":[["अयुक्तः प्राकृतः स्तब्धः शठो नैष्कृतिकोऽलसः।",0.0,4.17],["विषादी दीर्घसूत्री च कर्ता तामस उच्यते॥",4.14,8.59]]},{"n":29,"d":9.25,"p":[["बुद्धेर्भेदं धृतेश्चैव गुणतस्त्रिविधं शृणु।",0.0,4.17],["प्रोच्यमानमशेषेण पृथक्त्वेन धनञ्जय॥",4.92,9.25]]},{"n":30,"d":9.53,"p":[["प्रवृत्तिं च निवृत्तिं च कार्याकार्ये भयाभये।",0.0,4.08],["बन्धं मोक्षं च या वेत्ति बुद्धिः सा पार्थ सात्त्विकी॥",4.05,9.53]]},{"n":31,"d":9.17,"p":[["यया धर्ममधर्मं च कार्यं चाकार्यमेव च।",0.0,4.67],["अयथावत्प्रजानाति बुद्धिः सा पार्थ राजसी ॥",4.64,9.17]]},{"n":32,"d":8.83,"p":[["अधर्मं धर्ममिति या मन्यते तमसावृता।",0.0,2.75],["सर्वार्थान्विपरीतांश्च बुद्धिः सा पार्थ तामसी॥",4.14,8.83]]},{"n":33,"d":9.17,"p":[["धृत्या यया धारयते मनःप्राणेन्द्रियक्रियाः।",0.0,4.32],["योगेनाव्यभिचारिण्या धृतिः सा पार्थ सात्त्विकी॥",4.29,9.17]]},{"n":34,"d":9.17,"p":[["यया तु धर्मकामार्थान् धृत्या धारयतेऽर्जुन।",0.0,4.44],["प्रसङ्गेन फलाकाङ्क्षी धृतिः सा पार्थ राजसी॥",4.41,9.17]]},{"n":35,"d":8.71,"p":[["यया स्वप्नं भयं शोकं विषादं मदमेव च।",0.0,4.52],["न विमुञ्चति दुर्मेधा धृतिः सा पार्थ तामसी॥",4.49,8.71]]},{"n":36,"d":9.11,"p":[["सुखं त्विदानीं त्रिविधं शृणु मे भरतर्षभ।",0.0,4.68],["अभ्यासाद्रमते यत्र दुःखान्तं च निगच्छति॥",4.65,9.11]]},{"n":37,"d":9.33,"p":[["यत्तदग्रे विषमिव परिणामेऽमृतोपमम्।",0.0,2.84],["तत्सुखं सात्त्विकं प्रोक्तमात्मबुद्धिप्रसादजम्॥",4.17,9.33]]},{"n":38,"d":8.33,"p":[["विषयेन्द्रियसंयोगाद् यत्तदग्रेऽमृतोपमम्।",0.0,4.12],["परिणामे विषमिव तत्सुखं राजसं स्मृतम्॥",4.09,8.33]]},{"n":39,"d":9.31,"p":[["यदग्रे चानुबन्धे च सुखं मोहनमात्मनः।",0.0,4.53],["निद्रालस्यप्रमादोत्थं तत्तामसमुदाहृतम्॥",4.5,9.31]]},{"n":40,"d":9.33,"p":[["न तदस्ति पृथिव्यां वा दिवि देवेषु वा पुनः।",0.0,4.2],["सत्त्वं प्रकृतिजैर्मुक्तं यदेभिः स्यात्त्रिभिर्गुणैः॥",4.17,9.33]]},{"n":41,"d":9.31,"p":[["ब्राह्मणक्षत्रियविशां शूद्राणां च परन्तप।",0.0,4.64],["कर्माणि प्रविभक्तानि स्वभावप्रभवैर्गुणैः॥",4.61,9.31]]},{"n":42,"d":9.33,"p":[["शमो दमस्तपः शौचं क्षान्तिरार्जवमेव च।",0.01,4.36],["ज्ञानं विज्ञानमास्तिक्यं ब्रह्मकर्म स्वभावजम्॥",4.33,9.33]]},{"n":43,"d":9.81,"p":[["शौर्यं तेजो धृतिर्दाक्ष्यं युद्धे चाप्यपलायनम्।",0.0,4.99],["दानमीश्वरभावश्च क्षात्रं कर्म स्वभावजम्॥",4.96,9.81]]},{"n":44,"d":9.29,"p":[["कृषिगौरक्ष्यवाणिज्यं वैश्यकर्म स्वभावजम्।",0.0,4.6],["परिचर्यात्मकं कर्म शूद्रस्यापि स्वभावजम्॥",4.57,9.29]]},{"n":45,"d":8.63,"p":[["स्वे स्वे कर्मण्यभिरतः संसिद्धिं लभते नरः।",0.0,3.44],["स्वकर्मनिरतः सिद्धिं यथा विन्दति तच्छृणुु॥",4.65,8.63]]},{"n":46,"d":9.33,"p":[["यतः प्रवृत्तिर्भूतानां येन सर्वमिदं ततम्।",0.0,4.75],["स्वकर्मणा तमभ्यर्च्य सिद्धिं विन्दति मानवः॥",4.72,9.33]]},{"n":47,"d":9.47,"p":[["श्रेयान्स्वधर्मो विगुणः परधर्मात्स्वनुष्ठितात्।",0.0,4.88],["स्वभावनियतं कर्म कुर्वन्नाप्नोति किल्बिषम्॥",4.85,9.47]]},{"n":48,"d":8.31,"p":[["सहजं कर्म कौन्तेय सदोषमपि न त्यजेत्।",0.0,3.01],["सर्वारम्भा हि दोषेण धूमेनाग्निरिवावृताः॥",3.58,8.31]]},{"n":49,"d":8.57,"p":[["असक्तबुद्धिः सर्वत्र जितात्मा विगतस्पृहः।",0.0,3.84],["नैष्कर्म्यसिद्धिं परमां सन्न्यासेनाधिगच्छति॥",3.81,8.57]]},{"n":50,"d":9.41,"p":[["सिद्धिं प्राप्तो यथा ब्रह्म तथाप्नोति निबोध मे।",0.0,4.71],["समासेनैव कौन्तेय निष्ठा ज्ञानस्य या परा॥",4.68,9.41]]},{"n":51,"d":9.61,"p":[["बुद्‍ध्‍या विशुद्धया युक्तो धृत्यात्मानं नियम्य च।",0.0,3.21],["शब्दादीन्विषयांस्त्यक्त्वा रागद्वेषौ व्युदस्य च॥",4.49,9.61]]},{"n":52,"d":9.61,"p":[["विविक्तसेवी लघ्वाशी यतवाक्‍कायमानसः।",0.0,4.76],["ध्यानयोगपरो नित्यं वैराग्यं समुपाश्रितः॥",4.73,9.61]]},{"n":53,"d":8.95,"p":[["अहङ्कारं बलं दर्पं कामं क्रोधं परिग्रहम्।",0.0,3.37],["विमुच्य निर्ममः शान्तो ब्रह्मभूयाय कल्पते॥",4.49,8.95]]},{"n":54,"d":9.71,"p":[["ब्रह्मभूतः प्रसन्नात्मा न शोचति न काङ्क्षति।",0.0,4.69],["समः सर्वेषु भूतेषु मद्भक्तिं लभते पराम्॥",4.66,9.71]]},{"n":55,"d":9.49,"p":[["भक्त्या मामभिजानाति यावान्यश्चास्मि तत्त्वतः।",0.0,4.42],["ततो मां तत्त्वतो ज्ञात्वा विशते तदनन्तरम्॥",4.88,9.49]]},{"n":56,"d":8.89,"p":[["सर्वकर्माण्यपि सदा कुर्वाणो मद्‍व्यपाश्रयः।",0.0,4.24],["मत्प्रसादादवाप्नोति शाश्वतं पदमव्ययम्॥",4.21,8.89]]},{"n":57,"d":8.57,"p":[["चेतसा सर्वकर्माणि मयि सन्न्यस्य मत्परः।",0.0,4.35],["बुद्धियोगमुपाश्रित्य मच्चित्तः सततं भव॥",4.32,8.57]]},{"n":58,"d":8.43,"p":[["मच्चित्तः सर्वदुर्गाणि मत्प्रसादात्तरिष्यसि।",0.0,4.48],["अथ चेत्त्वमहङ्कारान् न श्रोष्यसि विनङ्क्ष्यसि॥",4.45,8.43]]},{"n":59,"d":8.57,"p":[["यदहङ्कारमाश्रित्य न योत्स्य इति मन्यसे।",0.0,2.83],["मिथ्यैष व्यवसायस्ते प्रकृतिस्त्वां नियोक्ष्यति॥",4.09,8.57]]},{"n":60,"d":8.25,"p":[["स्वभावजेन कौन्तेय निबद्धः स्वेन कर्मणा।",0.01,4.11],["कर्तुं नेच्छसि यन्मोहात् करिष्यस्यवशोऽपि तत्॥",4.08,8.25]]},{"n":61,"d":9.65,"p":[["ईश्वरः सर्वभूतानां हृद्देशेऽर्जुन तिष्ठति।",0.0,5.11],["भ्रामयन्सर्वभूतानि यन्त्रारूढानि मायया॥",5.08,9.65]]},{"n":62,"d":9.37,"p":[["तमेव शरणं गच्छ सर्वभावेन भारत।",0.0,4.08],["तत्प्रसादात्परां शान्तिं स्थानं प्राप्स्यसि शाश्वतम्॥",4.05,9.37]]},{"n":63,"d":9.13,"p":[["इति ते ज्ञानमाख्यातं गुह्याद्‍गुह्यतरं मया।",0.0,5.07],["विमृश्यैतदशेषेण यथेच्छसि तथा कुरु॥",5.04,9.13]]},{"n":64,"d":8.47,"p":[["सर्वगुह्यतमं भूयः शृणु मे परमं वचः।",0.0,4.17],["इष्टोऽसि मे दृढमिति ततो वक्ष्यामि ते हितम्॥",4.14,8.47]]},{"n":65,"d":8.73,"p":[["मन्मना भव मद्भक्तो मद्याजी मां नमस्कुरु।",0.0,4.32],["मामेवैष्यसि सत्यं ते प्रतिजाने प्रियोऽसि मे॥",4.29,8.73]]},{"n":66,"d":9.99,"p":[["सर्वधर्मान्परित्यज्य मामेकं शरणं व्रज।",0.0,3.36],["अहं त्वा सर्वपापेभ्यो मोक्षयिष्यामि मा शुचः॥",4.66,9.99]]},{"n":67,"d":8.57,"p":[["इदं ते नातपस्काय नाभक्ताय कदाचन।",0.0,2.58],["न चाशुश्रूषवे वाच्यं न च मां योऽभ्यसूयति॥",3.81,8.57]]},{"n":68,"d":9.69,"p":[["य इमं परमं गुह्यं मद्भक्तेष्वभिधास्यति।",0.0,4.44],["भक्तिं मयि परां कृत्वा मामेवैष्यत्यसंशयः॥",4.41,9.69]]},{"n":69,"d":8.87,"p":[["न च तस्मान्मनुष्येषु कश्चिन्मे प्रियकृत्तमः।",0.0,4.92],["भविता न च मे तस्मादन्यः प्रियतरो भुवि॥",4.89,8.87]]},{"n":70,"d":9.61,"p":[["अध्येष्यते च य इमं धर्म्यं संवादमावयोः।",0.0,5.07],["ज्ञानयज्ञेन तेनाहमिष्टः स्यामिति मे मतिः॥",5.04,9.61]]},{"n":71,"d":9.11,"p":[["श्रद्धावाननसूयश्च शृणुयादपि यो नरः।",0.0,3.97],["सोऽपि मुक्तः शुभाँल्लोकान् प्राप्नुयात्पुण्यकर्मणाम्॥",3.94,9.11]]},{"n":72,"d":9.43,"p":[["कच्चिदेतच्छ्रुतं पार्थ त्वयैकाग्रेण चेतसा।",0.0,4.84],["कच्चिदज्ञानसम्मोहः प्रनष्टस्ते धनञ्जय॥",4.81,9.43]]},{"n":73,"d":9.71,"p":[["अर्जुन उवाच",0.0,1.37,"UV_arjuna"],["नष्टो मोहः स्मृतिर्लब्धा त्वत्प्रसादान्मयाच्युत।",0.0,5.28],["स्थितोऽस्मि गतसन्देहः करिष्ये वचनं तव॥",5.25,9.71]]},{"n":74,"d":8.41,"p":[["संजय उवाच",0.04,1.33,"UV_sanjaya"],["इत्यहं वासुदेवस्य पार्थस्य च महात्मनः।",0.0,3.58],["संवादमिममश्रौषमद्‍भुतं रोमहर्षणम्॥",4.05,8.41]]},{"n":75,"d":9.61,"p":[["व्यासप्रसादाच्छ्रुतवानेतद्‍गुह्यमहं परम्।",0.0,3.89],["योगं योगेश्वरात्कृष्णात् साक्षात्कथयतः स्वयम्॥",4.61,9.61]]},{"n":76,"d":9.51,"p":[["राजन्संस्मृत्य संस्मृत्य संवादमिममद्‍भुतम्।",0.0,5.0],["केशवार्जुनयोः पुण्यं हृष्यामि च मुहुर्मुहुः॥",4.97,9.51]]},{"n":77,"d":9.45,"p":[["तच्च संस्मृत्य संस्मृत्य रूपमत्यद्‍भुतं हरेः।",0.0,4.54],["विस्मयो मे महान् राजन् हृष्यामि च पुनः पुनः॥",4.92,9.45]]},{"n":78,"d":9.81,"p":[["यत्र योगेश्वरः कृष्णो यत्र पार्थो धनुर्धरः।",0.0,4.93],["तत्र श्रीर्विजयो भूतिर्-ध्रुवा नीतिर्मतिर्मम॥",5.28,9.81]]}]}