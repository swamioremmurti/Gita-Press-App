{"ch":4,"v":[{"n":1,"d":9.51,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["इमं विवस्वते योगं प्रोक्तवानहमव्ययम्।",0.0,4.39],["विवस्वान्मनवे प्राह मनुरिक्ष्वाकवेऽब्रवीत्॥",4.97,9.51]]},{"n":2,"d":9.37,"p":[["एवं परम्पराप्राप्त-मिमं राजर्षयो विदुः।",0.0,4.63],["स कालेनेह महता योगो नष्टः परन्तप॥",5.0,9.37]]},{"n":3,"d":9.87,"p":[["स एवायं मया तेऽद्य योगः प्रोक्तः पुरातनः।",0.01,4.92],["भक्तोऽसि मे सखा चेति रहस्यं ह्येतदुत्तमम्॥",5.37,9.87]]},{"n":4,"d":8.97,"p":[["अर्जुन उवाच",0.0,1.37,"UV_arjuna"],["अपरं भवतो जन्म परं जन्म विवस्वतः।",0.0,4.06],["कथमेतद्विजानीयां त्वमादौ प्रोक्तवानिति॥",4.44,8.97]]},{"n":5,"d":9.21,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["बहूनि मे व्यतीतानि जन्मानि तव चार्जुन।",0.0,4.46],["तान्यहं वेद सर्वाणि न त्वं वेत्थ परन्तप॥",4.8,9.21]]},{"n":6,"d":9.95,"p":[["अजोऽपि सन्नव्ययात्मा भूतानामीश्वरोऽपि सन्।",0.0,4.77],["प्रकृतिं स्वामधिष्ठाय सम्भवाम्यात्ममायया॥",5.29,9.95]]},{"n":7,"d":9.61,"p":[["यदा यदा हि धर्मस्य ग्लानिर्भवति भारत।",0.0,4.47],["अभ्युत्थानमधर्मस्य तदात्मानं सृजाम्यहम्॥",4.84,9.61]]},{"n":8,"d":9.95,"p":[["परित्राणाय साधूनां विनाशाय च दुष्कृताम्।",0.0,4.79],["धर्मसंस्थापनार्थाय सम्भवामि युगे युगे॥",5.49,9.95]]},{"n":9,"d":9.47,"p":[["जन्म कर्म च मे दिव्यमेवं यो वेत्ति तत्त्वतः।",0.0,4.53],["त्यक्त्वा देहं पुनर्जन्म नैति मामेति सोऽर्जुन॥",4.85,9.47]]},{"n":10,"d":9.87,"p":[["वीतरागभयक्रोधा मन्मया मामुपाश्रिताः।",0.0,4.66],["बहवो ज्ञानतपसा पूता मद्भावमागताः॥",5.13,9.87]]},{"n":11,"d":10.21,"p":[["ये यथा मां प्रपद्यन्ते तांस्तथैव भजाम्यहम्।",0.0,4.95],["मम् वर्त्मानुवर्तन्ते मनुष्याः पार्थ सर्वशः॥",5.52,10.21]]},{"n":12,"d":9.31,"p":[["काङ्क्षन्तः कर्मणां सिद्धिं यजन्त इह देवताः।",0.0,4.49],["क्षिप्रं हि मानुषे लोके सिद्धिर्भवति कर्मजा॥",4.81,9.31]]},{"n":13,"d":9.39,"p":[["चातुर्वर्ण्यं मया सृष्टं गुणकर्मविभागशः।",0.0,4.61],["तस्य कर्तारमपि मां विद्‍ध्यकर्तारमव्ययम्॥",4.97,9.39]]},{"n":14,"d":9.37,"p":[["न मां कर्माणि लिम्पन्ति न मे कर्मफले स्पृहा।",0.0,4.55],["इति मां योऽभिजानाति कर्मभिर्न स बध्यते॥",4.92,9.37]]},{"n":15,"d":9.65,"p":[["एवं ज्ञात्वा कृतं कर्म पूर्वैरपि मुमुक्षुभिः।",0.0,4.55],["कुरु कर्मैव तस्मात्त्वं पूर्वैः पूर्वतरं कृतम्॥",4.88,9.65]]},{"n":16,"d":9.73,"p":[["किं कर्म किमकर्मेति कवयोऽप्यत्र मोहिताः।",0.0,4.31],["तत्ते कर्म प्रवक्ष्यामि यज्ज्ञात्वा मोक्ष्यसेऽशुभात्॥",4.65,9.73]]},{"n":17,"d":9.23,"p":[["कर्मणो ह्यपि बोद्धव्यं बोद्धव्यं च विकर्मणः।",0.0,4.57],["अकर्मणश्च बोद्धव्यं गहना कर्मणो गतिः॥",4.93,9.23]]},{"n":18,"d":9.11,"p":[["कर्मण्यकर्म यः पश्येदकर्मणि च कर्म यः।",0.0,4.47],["स बुद्धिमान्मनुष्येषु स युक्तः कृत्स्नकर्मकृत्॥",4.85,9.11]]},{"n":19,"d":10.01,"p":[["यस्य सर्वे समारम्भाः कामसङ्कल्पवर्जिताः।",0.0,4.83],["ज्ञानाग्निदग्धकर्माणं तमाहुः पण्डितं बुधाः॥",5.32,10.01]]},{"n":20,"d":9.47,"p":[["त्यक्त्वा कर्मफलासङ्गं नित्यतृप्तो निराश्रयः।",0.0,4.7],["कर्मण्यभिप्रवृत्तोऽपि नैव किञ्चित्करोति सः॥",5.05,9.47]]},{"n":21,"d":9.73,"p":[["निराशीर्यतचित्तात्मा त्यक्तसर्वपरिग्रहः।",0.0,4.59],["शारीरं केवलं कर्म कुर्वन्नाप्नोति किल्बिषम्॥",5.0,9.73]]},{"n":22,"d":9.63,"p":[["यदृच्छालाभसन्तुष्टो द्वन्द्वातीतो विमत्सरः।",0.0,4.89],["समः सिद्धावसिद्धौ च कृत्वापि न निबध्यते॥",5.25,9.63]]},{"n":23,"d":9.43,"p":[["गतसङ्गस्य मुक्तस्य ज्ञानावस्थितचेतसः।",0.0,4.67],["यज्ञायाचरतः कर्म समग्रं प्रविलीयते॥",5.05,9.43]]},{"n":24,"d":10.05,"p":[["ब्रह्मार्पणं ब्रह्म हविर्-ब्रह्माग्नौ ब्रह्मणा हुतम्।",0.0,4.9],["ब्रह्मैव तेन गन्तव्यं ब्रह्मकर्मसमाधिना॥",5.56,10.05]]},{"n":25,"d":9.71,"p":[["दैवमेवापरे यज्ञं योगिनः पर्युपासते।",0.0,4.57],["ब्रह्माग्नावपरे यज्ञं यज्ञेनैवोपजुह्वति॥",5.05,9.71]]},{"n":26,"d":9.69,"p":[["श्रोत्रादीनीन्द्रियाण्यन्ये संयमाग्निषु जुह्वति।",0.0,4.88],["शब्दादीन्विषयानन्य इन्द्रियाग्निषु जुह्वति॥",5.28,9.69]]},{"n":27,"d":9.37,"p":[["सर्वाणीन्द्रियकर्माणि प्राणकर्माणि चापरे।",0.0,4.55],["आत्मसंयमयोगाग्नौ जुह्वति ज्ञानदीपिते॥",4.92,9.37]]},{"n":28,"d":10.01,"p":[["द्रव्ययज्ञास्तपोयज्ञा योगयज्ञास्तथापरे।",0.0,4.94],["स्वाध्यायज्ञानयज्ञाश्च यतयः संशितव्रताः॥",5.24,10.01]]},{"n":29,"d":9.71,"p":[["अपाने जुह्वति प्राणं प्राणेऽपानं तथापरे।",0.0,4.53],["प्राणापानगती रुद्‍ध्वा प्राणायामपरायणाः॥",4.89,9.71]]},{"n":30,"d":9.33,"p":[["अपरे नियताहाराः प्राणान्प्राणेषु जुह्वति।",0.0,4.44],["सर्वेऽप्येते यज्ञविदो यज्ञक्षपितकल्मषाः॥",4.84,9.33]]},{"n":31,"d":9.59,"p":[["यज्ञशिष्टामृतभुजो यान्ति ब्रह्म सनातनम्।",0.0,4.51],["नायं लोकोऽस्त्ययज्ञस्य कुतोऽन्यः कुरुसत्तम॥",5.09,9.59]]},{"n":32,"d":9.73,"p":[["एवं बहुविधा यज्ञा वितता ब्रह्मणो मुखे।",0.0,4.47],["कर्मजान्विद्धि तान्सर्वानेवं ज्ञात्वा विमोक्ष्यसे॥",4.84,9.73]]},{"n":33,"d":10.03,"p":[["श्रेयान्द्रव्यमयाद्यज्ञाज्-ज्ञानयज्ञः परन्तप।",0.0,5.08],["सर्वं कर्माखिलं पार्थ ज्ञाने परिसमाप्यते॥",5.53,10.03]]},{"n":34,"d":9.27,"p":[["तद्विद्धि प्रणिपातेन परिप्रश्नेन सेवया।",0.0,4.41],["उपदेक्ष्यन्ति ते ज्ञानं ज्ञानिनस्तत्त्वदर्शिनः॥",4.81,9.27]]},{"n":35,"d":9.65,"p":[["यज्ज्ञात्वा न पुनर्मोहमेवं यास्यसि पाण्डव।",0.0,4.6],["येन भूतान्यशेषेण द्रक्ष्यस्यात्मन्यथो मयि॥",4.96,9.65]]},{"n":36,"d":9.57,"p":[["अपि चेदसि पापेभ्यः सर्वेभ्यः पापकृत्तमः।",0.0,4.89],["सर्वं ज्ञानप्लवेनैव वृजिनं सन्तरिष्यसि॥",5.28,9.57]]},{"n":37,"d":9.85,"p":[["यथैधांसि समिद्धोऽग्निर्-भस्मसात्कुरुतेऽर्जुन।",0.0,4.63],["ज्ञानाग्निः सर्वकर्माणि भस्मसात्कुरुते तथा॥",5.12,9.85]]},{"n":38,"d":9.03,"p":[["न हि ज्ञानेन सदृशं पवित्रमिह विद्यते।",0.0,4.3],["तत्स्वयं योगसंसिद्धः कालेनात्मनि विन्दति॥",4.65,9.03]]},{"n":39,"d":10.15,"p":[["श्रद्धावाँल्लभते ज्ञानं तत्परः संयतेन्द्रियः।",0.01,5.11],["ज्ञानं लब्ध्वा परां शान्तिमचिरेणाधिगच्छति॥",5.61,10.15]]},{"n":40,"d":9.49,"p":[["अज्ञश्चाश्रद्दधानश्च संशयात्मा विनश्यति।",0.0,4.65],["नायं लोकोऽस्ति न परो न सुखं संशयात्मनः॥",5.08,9.49]]},{"n":41,"d":9.75,"p":[["योगसन्न्यस्तकर्माणं ज्ञानसञ्छिन्नसंशयम्।",0.0,4.82],["आत्मवन्तं न कर्माणि निबध्नन्ति धनंजय॥",5.41,9.75]]},{"n":42,"d":10.65,"p":[["तस्मादज्ञानसम्भूतं हृत्स्थं ज्ञानासिनात्मनः।",0.0,5.36],["छित्त्वैनं संशयं योगमातिष्ठोत्तिष्ठ भारत॥",5.72,10.65]]}]}