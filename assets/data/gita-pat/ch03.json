{"ch":3,"v":[{"n":1,"d":9.67,"p":[["अर्जुन उवाच",0.0,1.37,"UV_arjuna"],["ज्यायसी चेत्कर्मणस्ते मता बुद्धिर्जनार्दन।",0.0,4.91],["तत्किं कर्मणि घोरे मां नियोजयसि केशव॥",5.25,9.67]]},{"n":2,"d":9.75,"p":[["व्यामिश्रेणेव वाक्येन बुद्धिं मोहयसीव मे।",0.0,4.58],["तदेकं वद निश्चित्य येन श्रेयोऽहमाप्नुयाम्॥",4.93,9.75]]},{"n":3,"d":10.32,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["लोकेऽस्मिन्द्विविधा निष्ठा पुरा प्रोक्ता मयानघ।",0.0,4.87],["ज्ञानयोगेन साङ्ख्यानां कर्मयोगेन योगिनाम्॥",5.36,10.32]]},{"n":4,"d":9.09,"p":[["न कर्मणामनारम्भान् नैष्कर्म्यं पुरुषोऽश्नुते।",0.0,4.61],["न च सन्न्यसनादेव सिद्धिं समधिगच्छति॥",4.96,9.09]]},{"n":5,"d":8.75,"p":[["न हि कश्चित्क्षणमपि जातु तिष्ठत्यकर्मकृत्।",0.0,3.73],["कार्यते ह्यवशः कर्म सर्वः प्रकृतिजैर्गुणैः॥",4.33,8.75]]},{"n":6,"d":10.41,"p":[["कर्मेन्द्रियाणि संयम्य य आस्ते मनसा स्मरन्।",0.0,4.72],["इन्द्रियार्थान्विमूढात्मा मिथ्याचारः स उच्यते॥",5.24,10.41]]},{"n":7,"d":9.21,"p":[["यस्त्विन्द्रियाणि मनसा नियम्यारभतेऽर्जुन।",0.0,4.39],["कर्मेन्द्रियैः कर्मयोगमसक्तः स विशिष्यते॥",4.76,9.21]]},{"n":8,"d":9.29,"p":[["नियतं कुरु कर्म त्वं कर्म ज्यायो ह्यकर्मणः।",0.0,4.53],["शरीरयात्रापि च ते न प्रसिद्‍ध्येदकर्मणः॥",4.92,9.29]]},{"n":9,"d":10.03,"p":[["यज्ञार्थात्कर्मणोऽन्यत्र लोकोऽयं कर्मबन्धनः।",0.0,5.23],["तदर्थं कर्म कौन्तेय मुक्तसङ्गः समाचर॥",5.57,10.03]]},{"n":10,"d":9.37,"p":[["सहयज्ञाः प्रजाः सृष्ट्वा पुरोवाच प्रजापतिः।",0.0,4.83],["अनेन प्रसविष्यध्वमेष वोऽस्त्विष्टकामधुक्॥",5.2,9.37]]},{"n":11,"d":9.59,"p":[["देवान्भावयतानेन ते देवा भावयन्तु वः।",0.0,4.87],["परस्परं भावयन्तः श्रेयः परमवाप्स्यथ॥",5.25,9.59]]},{"n":12,"d":10.95,"p":[["इष्टान्भोगान्हि वो देवा दास्यन्ते यज्ञभाविताः।",0.0,5.23],["तैर्दत्तानप्रदायैभ्यो यो भुङ्‍क्ते स्तेन एव सः॥",5.57,10.95]]},{"n":13,"d":10.07,"p":[["यज्ञशिष्टाशिनः सन्तो मुच्यन्ते सर्वकिल्बिषैः।",0.0,4.74],["भुञ्जते ते त्वघं पापा ये पचन्त्यात्मकारणात्॥",5.25,10.07]]},{"n":14,"d":9.75,"p":[["अन्नाद्भवन्ति भूतानि पर्जन्यादन्नसम्भवः।",0.0,4.85],["यज्ञाद्भवति पर्जन्यो यज्ञः कर्मसमुद्भवः॥",5.21,9.75]]},{"n":15,"d":9.97,"p":[["कर्म ब्रह्मोद्भवं विद्धि ब्रह्माक्षरसमुद्भवम्।",0.0,4.72],["तस्मात्सर्वगतं ब्रह्म नित्यं यज्ञे प्रतिष्ठितम्॥",5.28,9.97]]},{"n":16,"d":9.23,"p":[["एवं प्रवर्तितं चक्रं नानुवर्तयतीह यः।",0.0,4.54],["अघायुरिन्द्रियारामो मोघं पार्थ स जीवति॥",4.89,9.23]]},{"n":17,"d":9.39,"p":[["यस्त्वात्मरतिरेव स्यादात्मतृप्तश्च मानवः।",0.0,4.55],["आत्मन्येव च सन्तुष्टस्-तस्य कार्यं न विद्यते॥",4.93,9.39]]},{"n":18,"d":9.77,"p":[["नैव तस्य कृतेनार्थो नाकृतेनेह कश्चन।",0.0,4.57],["न चास्य सर्वभूतेषु कश्चिदर्थव्यपाश्रयः॥",4.92,9.77]]},{"n":19,"d":9.31,"p":[["तस्मादसक्तः सततं कार्यं कर्म समाचर।",0.0,4.44],["असक्तो ह्याचरन्कर्म परमाप्नोति पूरुषः॥",4.77,9.31]]},{"n":20,"d":8.95,"p":[["कर्मणैव हि संसिद्धिमास्थिता जनकादयः।",0.0,4.4],["लोकसङ्ग्रहमेवापि सम्पश्यन्कर्तुमर्हसि॥",4.81,8.95]]},{"n":21,"d":9.13,"p":[["यद्यदाचरति श्रेष्ठस् तत्तदेवेतरो जनः।",0.0,4.57],["स यत्प्रमाणं कुरुते लोकस्तदनुवर्तते॥",4.92,9.13]]},{"n":22,"d":9.23,"p":[["न मे पार्थास्ति कर्तव्यं त्रिषु लोकेषु किंचन।",0.0,4.55],["नानवाप्तमवाप्तव्यं वर्त एव च कर्मणि॥",4.97,9.23]]},{"n":23,"d":9.53,"p":[["यदि ह्यहं न वर्तेयं जातु कर्मण्यतन्द्रितः।",0.0,4.47],["मम वर्त्मानुवर्तन्ते मनुष्याः पार्थ सर्वशः॥",4.84,9.53]]},{"n":24,"d":9.97,"p":[["उत्सीदेयुरिमे लोका न कुर्यां कर्म चेदहम्।",0.0,4.6],["संकरस्य च कर्ता स्यामुपहन्यामिमाः प्रजाः॥",5.48,9.97]]},{"n":25,"d":10.59,"p":[["सक्ताः कर्मण्यविद्वांसो यथा कुर्वन्ति भारत।",0.0,4.97],["कुर्याद्विद्वांस्तथासक्तश्-चिकीर्षुर्लोकसङ्ग्रहम्॥",5.33,10.59]]},{"n":26,"d":10.13,"p":[["न बुद्धिभेदं जनयेदज्ञानां कर्मसङ्गिनाम्।",0.0,4.79],["जोषयेत्सर्वकर्माणि विद्वान्युक्तः समाचरन्॥",5.44,10.13]]},{"n":27,"d":9.29,"p":[["प्रकृतेः क्रियमाणानि गुणैः कर्माणि सर्वशः।",0.0,4.61],["अहङ्कारविमूढात्मा कर्ताहमिति मन्यते॥",4.96,9.29]]},{"n":28,"d":8.99,"p":[["तत्त्ववित्तु महाबाहो गुणकर्मविभागयोः।",0.0,4.4],["गुणा गुणेषु वर्तन्त इति मत्वा न सज्जते॥",4.85,8.99]]},{"n":29,"d":9.35,"p":[["प्रकृतेर्गुणसम्मूढाः सज्जन्ते गुणकर्मसु।",0.0,4.45],["तानकृत्स्नविदो मन्दान् कृत्स्नविन्न विचालयेत्॥",4.81,9.35]]},{"n":30,"d":9.75,"p":[["मयि सर्वाणि कर्माणि सन्न्यस्याध्यात्मचेतसा।",0.0,4.56],["निराशीर्निर्ममो भूत्वा युध्यस्व विगतज्वरः॥",4.93,9.75]]},{"n":31,"d":9.43,"p":[["ये मे मतमिदं नित्यमनुतिष्ठन्ति मानवाः।",0.0,4.33],["श्रद्धावन्तोऽनसूयन्तो मुच्यन्ते तेऽपि कर्मभिः॥",4.73,9.43]]},{"n":32,"d":10.01,"p":[["ये त्वेतदभ्यसूयन्तो नानुतिष्ठन्ति मे मतम्।",0.0,4.73],["सर्वज्ञानविमूढांस्तान् विद्धि नष्टानचेतसः॥",5.28,10.01]]},{"n":33,"d":9.19,"p":[["सदृशं चेष्टते स्वस्याः प्रकृतेर्ज्ञानवानपि।",0.0,4.47],["प्रकृतिं यान्ति भूतानि निग्रहः किं करिष्यति॥",4.81,9.19]]},{"n":34,"d":9.63,"p":[["इन्द्रियस्येन्द्रियस्यार्थे रागद्वेषौ व्यवस्थितौ।",0.0,4.94],["तयोर्न वशमागच्छेत् तौ ह्यस्य परिपन्थिनौ॥",5.29,9.63]]},{"n":35,"d":9.69,"p":[["श्रेयान्स्वधर्मो विगुणः परधर्मात्स्वनुष्ठितात्।",0.0,4.67],["स्वधर्मे निधनं श्रेयः परधर्मो भयावहः॥",5.24,9.69]]},{"n":36,"d":8.97,"p":[["अर्जुन उवाच",0.0,1.37,"UV_arjuna"],["अथ केन प्रयुक्तोऽयं पापं चरति पूरुषः।",0.0,4.41],["अनिच्छन्नपि वार्ष्णेय बलादिव नियोजितः॥",4.76,8.97]]},{"n":37,"d":9.37,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["काम एष क्रोध एष रजोगुणसमुद्भवः।",0.0,4.47],["महाशनो महापाप्मा विद्‍ध्येनमिह वैरिणम्॥",4.88,9.37]]},{"n":38,"d":10.05,"p":[["धूमेनाव्रियते वह्निर्-यथादर्शो मलेन च।",0.0,4.86],["यथोल्बेनावृतो गर्भस्-तथा तेनेदमावृतम्॥",5.2,10.05]]},{"n":39,"d":9.45,"p":[["आवृतं ज्ञानमेतेन ज्ञानिनो नित्यवैरिणा।",0.0,4.57],["कामरूपेण कौन्तेय दुष्पूरेणानलेन च॥",4.96,9.45]]},{"n":40,"d":9.47,"p":[["इन्द्रियाणि मनो बुद्धिरस्याधिष्ठानमुच्यते।",0.0,4.48],["एतैर्विमोहयत्येष ज्ञानमावृत्य देहिनम्॥",4.85,9.47]]},{"n":41,"d":9.57,"p":[["तस्मात्त्वमिन्द्रियाण्यादौ नियम्य भरतर्षभ।",0.0,4.5],["पाप्मानं प्रजहि ह्येनं ज्ञानविज्ञाननाशनम्॥",5.08,9.57]]},{"n":42,"d":9.31,"p":[["इन्द्रियाणि पराण्याहुरिन्द्रियेभ्यः परं मनः।",0.0,4.48],["मनसस्तु परा बुद्धिर्-यो बुद्धेः परतस्तु सः॥",4.85,9.31]]},{"n":43,"d":10.01,"p":[["एवं बुद्धेः परं बुद्‍ध्‍वा संस्तभ्यात्मानमात्मना।",0.0,5.09],["जहि शत्रुं महाबाहो कामरूपं दुरासदम्॥",5.48,10.01]]}]}