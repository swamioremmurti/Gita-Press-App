{"ch":8,"v":[{"n":1,"d":9.23,"p":[["अर्जुन उवाच",0.0,1.37,"UV_arjuna"],["किं तद्‍ब्रह्म किमध्यात्मं किं कर्म पुरुषोत्तम।",0.0,4.53],["अधिभूतं च किं प्रोक्तमधिदैवं किमुच्यते॥",4.89,9.23]]},{"n":2,"d":9.31,"p":[["अधियज्ञः कथं कोऽत्र देहेऽस्मिन्मधुसूदन।",0.0,4.58],["प्रयाणकाले च कथं ज्ञेयोऽसि नियतात्मभिः॥",4.93,9.31]]},{"n":3,"d":9.23,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["अक्षरं ब्रह्म परमं स्वभावोऽध्यात्ममुच्यते।",0.0,4.36],["भूतभावोद्भवकरो विसर्गः कर्मसञ्ज्ञितः॥",4.81,9.23]]},{"n":4,"d":9.41,"p":[["अधिभूतं क्षरो भावः पुरुषश्चाधिदैवतम्।",0.0,4.45],["अधियज्ञोऽहमेवात्र देहे देहभृतां वर॥",5.0,9.41]]},{"n":5,"d":9.85,"p":[["अन्तकाले च मामेव स्मरन्मुक्त्वा कलेवरम्।",0.0,4.54],["यः प्रयाति स मद्भावं याति नास्त्यत्र संशयः॥",5.12,9.85]]},{"n":6,"d":10.05,"p":[["यं यं वापि स्मरन्भावं त्यजत्यन्ते कलेवरम्।",0.0,4.76],["तं तमेवैति कौन्तेय सदा तद्भावभावितः॥",5.6,10.05]]},{"n":7,"d":9.65,"p":[["तस्मात्सर्वेषु कालेषु मामनुस्मर युध्य च।",0.0,4.57],["मय्यर्पितमनोबुद्धिर्-मामेवैष्यस्यसंशयम्॥",4.96,9.65]]},{"n":8,"d":9.33,"p":[["अभ्यासयोगयुक्तेन चेतसा नान्यगामिना।",0.0,4.49],["परमं पुरुषं दिव्यं याति पार्थानुचिन्तयन्॥",4.84,9.33]]},{"n":9,"d":14.02,"p":[["कविं पुराणमनुशासितार-",0.0,2.92],["मणोरणीयांसमनुस्मरेद्यः।",3.29,6.69],["सर्वस्य धातारमचिन्त्यरूप-",7.13,10.46],["मादित्यवर्णं तमसः परस्तात्॥",10.84,14.02]]},{"n":10,"d":14.49,"p":[["प्रयाणकाले मनसाचलेन",0.0,3.19],["भक्त्या युक्तो योगबलेन चैव।",3.65,7.0],["भ्रुवोर्मध्ये प्राणमावेश्य सम्यक्",7.45,10.71],["स तं परं पुरुषमुपैति दिव्यम्॥",11.28,14.49]]},{"n":11,"d":13.98,"p":[["यदक्षरं वेदविदो वदन्ति",0.0,2.81],["विशन्ति यद्यतयो वीतरागाः।",3.17,6.47],["यदिच्छन्तो ब्रह्मचर्यं चरन्ति",6.81,10.24],["तत्ते पदं सङ्ग्रहेण प्रवक्ष्ये॥",10.56,13.98]]},{"n":12,"d":9.63,"p":[["सर्वद्वाराणि संयम्य मनो हृदि निरुध्य च।",0.0,4.42],["मूर्ध्न्याधायात्मनः प्राणमास्थितो योगधारणाम्॥",4.81,9.63]]},{"n":13,"d":9.71,"p":[["ओमित्येकाक्षरं ब्रह्म व्याहरन्मामनुस्मरन्।",0.0,4.69],["यः प्रयाति त्यजन्देहं स याति परमां गतिम्॥",5.25,9.71]]},{"n":14,"d":9.29,"p":[["अनन्यचेताः सततं यो मां स्मरति नित्यशः।",0.0,4.46],["तस्याहं सुलभः पार्थ नित्ययुक्तस्य योगिनः॥",4.8,9.29]]},{"n":15,"d":9.81,"p":[["मामुपेत्य पुनर्जन्म दुःखालयमशाश्वतम्।",0.0,4.43],["नाप्नुवन्ति महात्मानः संसिद्धिं परमां गताः॥",5.0,9.81]]},{"n":16,"d":9.39,"p":[["आब्रह्मभुवनाल्लोकाः पुनरावर्तिनोऽर्जुन।",0.0,4.72],["मामुपेत्य तु कौन्तेय पुनर्जन्म न विद्यते॥",5.13,9.39]]},{"n":17,"d":9.61,"p":[["सहस्रयुगपर्यन्तमहर्यद्‍ब्रह्मणो विदुः।",0.0,4.29],["रात्रिं युगसहस्रान्तां तेऽहोरात्रविदो जनाः॥",4.73,9.61]]},{"n":18,"d":10.03,"p":[["अव्यक्ताद्‍व्यक्तयः सर्वाः प्रभवन्त्यहरागमे।",0.0,4.71],["रात्र्यागमे प्रलीयन्ते तत्रैवाव्यक्तसञ्ज्ञके॥",5.13,10.03]]},{"n":19,"d":9.89,"p":[["भूतग्रामः स एवायं भूत्वा भूत्वा प्रलीयते।",0.0,5.13],["रात्र्यागमेऽवशः पार्थ प्रभवत्यहरागमे॥",5.56,9.89]]},{"n":20,"d":9.77,"p":[["परस्तस्मात्तु भावोऽन्यो-ऽव्यक्तोऽव्यक्तात्सनातनः।",0.0,5.09],["यः स सर्वेषु भूतेषु नश्यत्सु न विनश्यति॥",5.44,9.77]]},{"n":21,"d":9.39,"p":[["अव्यक्तोऽक्षर इत्युक्तस्-तमाहुः परमां गतिम्।",0.0,4.52],["यं प्राप्य न निवर्तन्ते तद्धाम परमं मम॥",5.09,9.39]]},{"n":22,"d":9.43,"p":[["पुरुषः स परः पार्थ भक्त्या लभ्यस्त्वनन्यया।",0.0,4.49],["यस्यान्तःस्थानि भूतानि येन सर्वमिदं ततम्॥",4.85,9.43]]},{"n":23,"d":9.85,"p":[["यत्र काले त्वनावृत्तिमावृत्तिं चैव योगिनः।",0.0,4.81],["प्रयाता यान्ति तं कालं वक्ष्यामि भरतर्षभ॥",5.16,9.85]]},{"n":24,"d":10.03,"p":[["अग्निर्ज्योतिरहः शुक्लः षण्मासा उत्तरायणम्।",0.0,4.83],["तत्र प्रयाता गच्छन्ति ब्रह्म ब्रह्मविदो जनाः॥",5.37,10.03]]},{"n":25,"d":10.19,"p":[["धूमो रात्रिस्तथा कृष्णः षण्मासा दक्षिणायनम्।",0.0,5.17],["तत्र चान्द्रमसं ज्योतिर्-योगी प्राप्य निवर्तते॥",5.73,10.19]]},{"n":26,"d":9.59,"p":[["शुक्लकृष्णे गती ह्येते जगतः शाश्वते मते।",0.0,4.72],["एकया यात्यनावृत्तिमन्ययावर्तते पुनः॥",5.13,9.59]]},{"n":27,"d":9.75,"p":[["नैते सृती पार्थ जानन् योगी मुह्यति कश्चन।",0.0,4.61],["तस्मात्सर्वेषु कालेषु योगयुक्तो भवार्जुन॥",4.97,9.75]]},{"n":28,"d":12.33,"p":[["वेदेषु यज्ञेषु तपःसु चैव",0.0,2.76],["दानेषु यत्पुण्यफलं प्रदिष्टम्।",3.21,5.96],["अत्येति तत्सर्वमिदं विदित्वा",6.48,9.24],["योगी परं स्थानमुपैति चाद्यम्॥",9.59,12.33]]}]}