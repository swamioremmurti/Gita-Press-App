{"ch":6,"v":[{"n":1,"d":9.25,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["अनाश्रितः कर्मफलं कार्यं कर्म करोति यः।",0.0,4.49],["स सन्न्यासी च योगी च न निरग्निर्न चाक्रियः॥",4.84,9.25]]},{"n":2,"d":9.69,"p":[["यं सन्न्यासमिति प्राहुर्-योगं तं विद्धि पाण्डव।",0.0,4.88],["न ह्यसन्न्यस्तसङ्कल्पो योगी भवति कश्चन॥",5.24,9.69]]},{"n":3,"d":9.35,"p":[["आरुरुक्षोर्मुनेर्योगं कर्म कारणमुच्यते।",0.0,4.52],["योगारूढस्य तस्यैव शमः कारणमुच्यते॥",4.97,9.35]]},{"n":4,"d":9.45,"p":[["यदा हि नेन्द्रियार्थेषु न कर्मस्वनुषज्जते।",0.0,4.42],["सर्वसङ्कल्पसन्न्यासी योगारूढस्तदोच्यते॥",4.8,9.45]]},{"n":5,"d":10.05,"p":[["उद्धरेदात्मनात्मानं नात्मानमवसादयेत्।",0.0,4.63],["आत्मैव ह्यात्मनो बन्धुरात्मैव रिपुरात्मनः॥",5.24,10.05]]},{"n":6,"d":9.83,"p":[["बन्धुरात्मात्मनस्तस्य येनात्मैवात्मना जितः।",0.0,5.16],["अनात्मनस्तु शत्रुत्वे वर्तेतात्मैव शत्रुवत्॥",5.49,9.83]]},{"n":7,"d":9.59,"p":[["जितात्मनः प्रशान्तस्य परमात्मा समाहितः।",0.0,4.51],["शीतोष्णसुखदुःखेषु तथा मानापमानयोः॥",4.93,9.59]]},{"n":8,"d":10.11,"p":[["ज्ञानविज्ञानतृप्तात्मा कूटस्थो विजितेन्द्रियः।",0.0,5.14],["युक्त इत्युच्यते योगी समलोष्टाश्मकाञ्चनः॥",5.49,10.11]]},{"n":9,"d":9.47,"p":[["सुहृन्मित्रार्युदासीनमध्यस्थद्वेष्यबन्धुषु।",0.01,4.75],["साधुष्वपि च पापेषु समबुद्धिर्विशिष्यते॥",5.13,9.47]]},{"n":10,"d":9.43,"p":[["योगी युञ्जीत सततमात्मानं रहसि स्थितः।",0.0,4.49],["एकाकी यतचित्तात्मा निराशीरपरिग्रहः॥",4.89,9.43]]},{"n":11,"d":9.55,"p":[["शुचौ देशे प्रतिष्ठाप्य स्थिरमासनमात्मनः।",0.0,4.67],["नात्युच्छ्रितं नातिनीचं चैलाजिनकुशोत्तरम्॥",5.05,9.55]]},{"n":12,"d":9.77,"p":[["तत्रैकाग्रं मनः कृत्वा यतचित्तेन्द्रियक्रियः।",0.0,4.92],["उपविश्यासने युञ्‍ज्‍याद् योगमात्मविशुद्धये॥",5.28,9.77]]},{"n":13,"d":9.55,"p":[["समं कायशिरोग्रीवं धारयन्नचलं स्थिरः।",0.0,4.52],["सम्प्रेक्ष्य नासिकाग्रं स्वं दिशश्चानवलोकयन्॥",4.85,9.55]]},{"n":14,"d":9.89,"p":[["प्रशान्तात्मा विगतभीर्-ब्रह्मचारिव्रते स्थितः।",0.0,4.96],["मनः संयम्य मच्चित्तो युक्त आसीत मत्परः॥",5.32,9.89]]},{"n":15,"d":9.69,"p":[["युञ्जन्नेवं सदात्मानं योगी नियतमानसः।",0.0,4.73],["शान्तिं निर्वाणपरमां मत्संस्थामधिगच्छति॥",5.12,9.69]]},{"n":16,"d":9.45,"p":[["नात्यश्नतस्तु योगोऽस्ति न चैकान्तमनश्नतः।",0.0,4.6],["न चाति स्वप्नशीलस्य जाग्रतो नैव चार्जुन॥",4.92,9.45]]},{"n":17,"d":9.25,"p":[["युक्ताहारविहारस्य युक्तचेष्टस्य कर्मसु।",0.0,4.41],["युक्तस्वप्नावबोधस्य योगो भवति दुःखहा॥",4.8,9.25]]},{"n":18,"d":9.47,"p":[["यदा विनियतं चित्तमात्मन्येवावतिष्ठते।",0.0,4.45],["निःस्पृहः सर्वकामेभ्यो युक्त इत्युच्यते तदा॥",4.81,9.47]]},{"n":19,"d":9.53,"p":[["यथा दीपो निवातस्थो नेङ्गते सोपमा स्मृता।",0.0,4.75],["योगिनो यतचित्तस्य युञ्जतो योगमात्मनः॥",5.16,9.53]]},{"n":20,"d":9.25,"p":[["यत्रोपरमते चित्तं निरुद्धं योगसेवया।",0.0,4.43],["यत्र चैवात्मनात्मानं पश्यन्नात्मनि तुष्यति॥",4.8,9.25]]},{"n":21,"d":9.57,"p":[["सुखमात्यन्तिकं यत्तद् बुद्धिग्राह्यमतीन्द्रियम्।",0.0,4.6],["वेत्ति यत्र न चैवायं स्थितश्चलति तत्त्वतः॥",5.16,9.57]]},{"n":22,"d":9.57,"p":[["यं लब्ध्वा चापरं लाभं मन्यते नाधिकं ततः।",0.0,5.0],["यस्मिन्स्थितो न दुःखेन गुरुणापि विचाल्यते॥",5.36,9.57]]},{"n":23,"d":9.83,"p":[["तं विद्याद्दुःखसंयोगवियोगं योगसञ्ज्ञितम्।",0.0,4.74],["स निश्चयेन योक्तव्यो योगोऽनिर्विण्णचेतसा॥",5.29,9.83]]},{"n":24,"d":9.83,"p":[["सङ्कल्पप्रभवान्कामांस्-त्यक्त्वा सर्वानशेषतः।",0.0,5.21],["मनसैवेन्द्रियग्रामं विनियम्य समन्ततः॥",5.61,9.83]]},{"n":25,"d":9.35,"p":[["शनैः शनैरुपरमेद् बुद्‍ध्या धृतिगृहीतया।",0.02,4.47],["आत्मसंस्थं मनः कृत्वा न किञ्चिदपि चिन्तयेत्॥",4.85,9.35]]},{"n":26,"d":8.95,"p":[["यतो यतो निश्चरति मनश्चञ्चलमस्थिरम्।",0.0,4.02],["ततस्ततो नियम्यैतदात्मन्येव वशं नयेत्॥",4.57,8.95]]},{"n":27,"d":9.09,"p":[["प्रशान्तमनसं ह्येनं योगिनं सुखमुत्तमम्।",0.0,4.34],["उपैति शान्तरजसं ब्रह्मभूतमकल्मषम्॥",4.88,9.09]]},{"n":28,"d":9.49,"p":[["युञ्जन्नेवं सदात्मानं योगी विगतकल्मषः।",0.0,4.78],["सुखेन ब्रह्मसंस्पर्श-मत्यन्तं सुखमश्नुते॥",5.12,9.49]]},{"n":29,"d":9.57,"p":[["सर्वभूतस्थमात्मानं सर्वभूतानि चात्मनि।",0.0,4.72],["ईक्षते योगयुक्तात्मा सर्वत्र समदर्शनः॥",5.12,9.57]]},{"n":30,"d":9.01,"p":[["यो मां पश्यति सर्वत्र सर्वं च मयि पश्यति।",0.0,4.39],["तस्याहं न प्रणश्यामि स च मे न प्रणश्यति॥",4.72,9.01]]},{"n":31,"d":9.93,"p":[["सर्वभूतस्थितं यो मां भजत्येकत्वमास्थितः।",0.0,5.18],["सर्वथा वर्तमानोऽपि स योगी मयि वर्तते॥",5.56,9.93]]},{"n":32,"d":9.27,"p":[["आत्मौपम्येन सर्वत्र समं पश्यति योऽर्जुन।",0.0,4.47],["सुखं वा यदि वा दुःखं स योगी परमो मतः॥",4.85,9.27]]},{"n":33,"d":10.2,"p":[["अर्जुन उवाच",0.0,1.37,"UV_arjuna"],["योऽयं योगस्त्वया प्रोक्तः साम्येन मधुसूदन।",0.0,4.89],["एतस्याहं न पश्यामि चञ्चलत्वात्स्थितिं स्थिराम्॥",5.24,10.2]]},{"n":34,"d":9.49,"p":[["चञ्चलं हि मनः कृष्ण प्रमाथि बलवद्दृढम्।",0.0,4.36],["तस्याहं निग्रहं मन्ये वायोरिव सुदुष्करम्॥",4.92,9.49]]},{"n":35,"d":9.31,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["असंशयं महाबाहो मनो दुर्निग्रहं चलम्।",0.0,4.36],["अभ्यासेन तु कौन्तेय वैराग्येण च गृह्यते॥",4.89,9.31]]},{"n":36,"d":9.09,"p":[["असंयतात्मना योगो दुष्प्राप इति मे मतिः।",0.0,4.18],["वश्यात्मना तु यतता शक्योऽवाप्तुमुपायतः॥",4.72,9.09]]},{"n":37,"d":9.25,"p":[["अर्जुन उवाच",0.0,1.37,"UV_arjuna"],["अयतिः श्रद्धयोपेतो योगाच्चलितमानसः।",0.0,4.48],["अप्राप्य योगसंसिद्धिं कां गतिं कृष्ण गच्छति॥",4.8,9.25]]},{"n":38,"d":9.27,"p":[["कच्चिन्नोभयविभ्रष्टश्-छिन्नाभ्रमिव नश्यति।",0.0,4.41],["अप्रतिष्ठो महाबाहो विमूढो ब्रह्मणः पथि॥",4.77,9.27]]},{"n":39,"d":9.43,"p":[["एतन्मे संशयं कृष्ण छेत्तुमर्हस्यशेषतः।",0.0,4.6],["त्वदन्यः संशयस्यास्य छेत्ता न ह्युपपद्यते॥",4.89,9.43]]},{"n":40,"d":9.23,"p":[["श्रीभगवानुवाच",0.0,1.65,"UV_bhagavan"],["पार्थ नैवेह नामुत्र विनाशस्तस्य विद्यते।",0.0,4.5],["न हि कल्याणकृत्कश्चिद् दुर्गतिं तात गच्छति॥",4.85,9.23]]},{"n":41,"d":10.35,"p":[["प्राप्य पुण्यकृतां लोकानुषित्वा शाश्वतीः समाः।",0.0,4.96],["शुचीनां श्रीमतां गेहे योगभ्रष्टोऽभिजायते॥",5.33,10.35]]},{"n":42,"d":9.39,"p":[["अथवा योगिनामेव कुले भवति धीमताम्।",0.0,4.37],["एतद्धि दुर्लभतरं लोके जन्म यदीदृशम्॥",4.97,9.39]]},{"n":43,"d":9.61,"p":[["तत्र तं बुद्धिसंयोगं लभते पौर्वदेहिकम्।",0.0,4.71],["यतते च ततो भूयः संसिद्धौ कुरुनन्दन॥",5.28,9.61]]},{"n":44,"d":9.45,"p":[["पूर्वाभ्यासेन तेनैव ह्रियते ह्यवशोऽपि सः।",0.0,4.63],["जिज्ञासुरपि योगस्य शब्दब्रह्मातिवर्तते॥",5.04,9.45]]},{"n":45,"d":9.37,"p":[["प्रयत्नाद्यतमानस्तु योगी संशुद्धकिल्बिषः।",0.0,4.63],["अनेकजन्मसंसिद्धस्-ततो याति परां गतिम्॥",5.0,9.37]]},{"n":46,"d":10.35,"p":[["तपस्विभ्योऽधिको योगी ज्ञानिभ्योऽपि मतोऽधिकः।",0.0,4.9],["कर्मिभ्यश्चाधिको योगी तस्माद्योगी भवार्जुन॥",5.25,10.35]]},{"n":47,"d":9.67,"p":[["योगिनामपि सर्वेषां मद्‍गतेनान्तरात्मना।",0.0,4.51],["श्रद्धावान्भजते यो मां स मे युक्ततमो मतः॥",4.81,9.67]]}]}