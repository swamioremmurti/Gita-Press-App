{"ch":1,"v":[{"n":1,"d":9.67,"p":[["धृतराष्ट्र उवाच",0.0,1.65,"UV_dhritarashtra"],["धर्मक्षेत्रे कुरुक्षेत्रे समवेता युयुत्सवः।",0.0,4.9],["मामकाः पाण्डवाश्चैव किमकुर्वत सञ्जय॥",5.29,9.67]]},{"n":2,"d":9.85,"p":[["सञ्जय उवाच",0.04,1.33,"UV_sanjaya"],["दृष्ट्वा तु पाण्डवानीकं व्यूढं दुर्योधनस्तदा।",0.0,5.07],["आचार्यमुपसङ्गम्य राजा वचनमब्रवीत्॥",5.44,9.85]]},{"n":3,"d":9.87,"p":[["पश्यैतां पाण्डुपुत्राणामाचार्य महतीं चमूम्।",0.0,4.89],["व्यूढां द्रुपदपुत्रेण तव शिष्येण धीमता॥",5.49,9.87]]},{"n":4,"d":9.27,"p":[["अत्र शूरा महेष्वासा भीमार्जुनसमा युधि।",0.0,4.51],["युयुधानो विराटश्च द्रुपदश्च महारथः॥",4.93,9.27]]},{"n":5,"d":10.05,"p":[["धृष्टकेतुश्चेकितानः काशिराजश्च वीर्यवान्।",0.0,5.11],["पुरुजित्कुन्तिभोजश्च शैब्यश्च नरपुङ्गवः॥",5.64,10.05]]},{"n":6,"d":10.31,"p":[["युधामन्युश्च विक्रान्त उत्तमौजाश्च वीर्यवान्।",0.0,5.03],["सौभद्रो द्रौपदेयाश्च सर्व एव महारथाः॥",5.61,10.31]]},{"n":7,"d":9.49,"p":[["अस्माकं तु विशिष्टा ये तान्निबोध द्विजोत्तम।",0.0,4.45],["नायका मम सैन्यस्य सञ्ज्ञार्थं तान्ब्रवीमि ते॥",4.88,9.49]]},{"n":8,"d":9.41,"p":[["भवान्भीष्मश्च कर्णश्च कृपश्च समितिञ्जयः।",0.0,4.56],["अश्वत्थामा विकर्णश्च सौमदत्तिस्तथैव च॥",4.92,9.41]]},{"n":9,"d":9.51,"p":[["अन्ये च बहवः शूरा मदर्थे त्यक्तजीविताः।",0.0,4.56],["नानाशस्त्रप्रहरणाः सर्वे युद्धविशारदाः॥",4.97,9.51]]},{"n":10,"d":10.49,"p":[["अपर्याप्तं तदस्माकं बलं भीष्माभिरक्षितम्।",0.0,4.92],["पर्याप्तं त्विदमेतेषां बलं भीमाभिरक्षितम्॥",5.48,10.49]]},{"n":11,"d":9.07,"p":[["अयनेषु च सर्वेषु यथाभागमवस्थिताः।",0.0,4.29],["भीष्ममेवाभिरक्षन्तु भवन्तः सर्व एव हि॥",4.81,9.07]]},{"n":12,"d":9.93,"p":[["तस्य सञ्जनयन्हर्षं कुरुवृद्धः पितामहः।",0.0,4.43],["सिंहनादं विनद्योच्चैः शङ्खं दध्मौ प्रतापवान्॥",4.8,9.93]]},{"n":13,"d":8.95,"p":[["ततः शङ्खाश्च भेर्यश्च पणवानकगोमुखाः।",0.0,4.52],["सहसैवाभ्यहन्यन्त स शब्दस्तुमुलोऽभवत्॥",4.93,8.95]]},{"n":14,"d":9.55,"p":[["ततः श्वेतैर्हयैर्युक्ते महति स्यन्दने स्थितौ।",0.0,4.59],["माधवः पाण्डवश्चैव दिव्यौ शङ्खौ प्रदध्मतुः॥",5.01,9.55]]},{"n":15,"d":10.37,"p":[["पाञ्चजन्यं हृषीकेशो देवदत्तं धनञ्जयः।",0.0,4.87],["पौण्ड्रं दध्मौ महाशङ्खं भीमकर्मा वृकोदरः॥",5.2,10.37]]},{"n":16,"d":8.89,"p":[["अनन्तविजयं राजा कुन्तीपुत्रो युधिष्ठिरः।",0.0,4.54],["नकुलः सहदेवश्च सुघोषमणिपुष्पकौ॥",4.92,8.89]]},{"n":17,"d":9.61,"p":[["काश्यश्च परमेष्वासः शिखण्डी च महारथः।",0.0,4.56],["धृष्टद्युुम्नो विराटश्च सात्यकिश्चापराजितः॥",4.96,9.61]]},{"n":18,"d":9.41,"p":[["द्रुपदो द्रौपदेयाश्च सर्वशः पृथिवीपते।",0.0,4.33],["सौभद्रश्च महाबाहुः शङ्खान्दध्मुः पृथक् पृथक्॥",4.72,9.41]]},{"n":19,"d":9.21,"p":[["स घोषो धार्तराष्ट्राणां हृदयानि व्यदारयत्।",0.0,4.41],["नभश्च पृथिवीं चैव तुमुलो व्यनुनादयन्॥",4.96,9.21]]},{"n":20,"d":9.97,"p":[["अथ व्यवस्थितान्दृष्ट्वा धार्तराष्ट्रान्कपिध्वजः।",0.0,5.08],["प्रवृत्ते शस्त्रसम्पाते धनुरुद्यम्य पाण्डवः॥",5.4,9.97]]},{"n":21,"d":9.23,"p":[["अर्जुन उवाच",0.0,1.37,"UV_arjuna"],["हृषीकेशं तदा वाक्य-मिदमाह महीपते।",0.04,4.28],["सेनयोरुभयोर्मध्ये रथं स्थापय मेऽच्युत॥",4.69,9.23]]},{"n":22,"d":9.93,"p":[["यावदेतान्निरीक्षेऽहं योद्धुकामानवस्थितान्।",0.0,5.09],["कैर्मया सह योद्धव्य-मस्मिन्‍रणसमुद्यमे॥",5.6,9.93]]},{"n":23,"d":9.59,"p":[["योत्स्यमानानवेक्षेऽहं य एतेऽत्र समागताः।",0.0,4.59],["धार्तराष्ट्रस्य दुर्बुद्धेर्-युद्धे प्रियचिकीर्षवः॥",5.05,9.59]]},{"n":24,"d":9.87,"p":[["सञ्जय उवाच",0.04,1.33,"UV_sanjaya"],["एवमुक्तो हृषीकेशो गुडाकेशेन भारत।",0.0,4.73],["सेनयोरुभयोर्मध्ये स्थापयित्वा रथोत्तमम्॥",5.13,9.87]]},{"n":25,"d":9.89,"p":[["भीष्मद्रोणप्रमुखतः सर्वेषां च महीक्षिताम्।",0.0,4.93],["उवाच पार्थ पश्यैतान् समवेतान्कुरूनिति॥",5.48,9.89]]},{"n":26,"d":10.67,"p":[["तत्रापश्यत्स्थितान्पार्थः पितॄनथ पितामहान्।",0.0,4.95],["आचार्यान्मातुलान्भ्रातॄन् पुत्रान्पौत्रान्सखींस्तथा॥",5.53,10.67]]},{"n":27,"d":9.29,"p":[["श्वशुरान्सुहृदश्चैव सेनयोरुभयोरपि।",0.0,4.15],["तान्समीक्ष्य स कौन्तेयः सर्वान्बन्धूनवस्थितान्॥",4.48,9.29]]},{"n":28,"d":9.39,"p":[["अर्जुन उवाच",0.0,1.37,"UV_arjuna"],["कृपया परयाविष्टो विषीदन्निदमब्रवीत्।",0.0,4.27],["दृष्ट्वेमं स्वजनं कृष्ण युयुत्सुं समुपस्थितम्॥",4.89,9.39]]},{"n":29,"d":8.79,"p":[["सीदन्ति मम गात्राणि मुखं च परिशुष्यति।",0.0,3.97],["वेपथुश्च शरीरे मे रोमहर्षश्च जायते॥",4.37,8.79]]},{"n":30,"d":9.33,"p":[["गाण्डीवं स्रंसते हस्तात् त्वक्चैव परिदह्यते।",0.0,4.59],["न च शक्नोम्यवस्थातुं भ्रमतीव च मे मनः॥",4.92,9.33]]},{"n":31,"d":9.21,"p":[["निमित्तानि च पश्यामि विपरीतानि केशव।",0.0,4.39],["न च श्रेयोऽनुपश्यामि हत्वा स्वजनमाहवे॥",4.72,9.21]]},{"n":32,"d":9.63,"p":[["न काङ्क्षे विजयं कृष्ण न च राज्यं सुखानि च।",0.0,4.44],["किं नो राज्येन गोविन्द किं भोगैर्जीवितेन वा॥",4.81,9.63]]},{"n":33,"d":10.3,"p":[["येषामर्थे काङ्क्षितं नो राज्यं भोगाः सुखानि च।",0.0,5.13],["त इमेऽवस्थिता युद्धे प्राणांस्त्यक्त्वा धनानि च॥",5.45,10.3]]},{"n":34,"d":9.97,"p":[["आचार्याः पितरः पुत्रास्-तथैव च पितामहाः।",0.0,4.6],["मातुलाः श्वशुराः पौत्राः श्यालाः सम्बन्धिनस्तथा॥",5.04,9.97]]},{"n":35,"d":9.35,"p":[["एतान्न हन्तुमिच्छामि घ्नतोऽपि मधुसूदन।",0.0,4.49],["अपि त्रैलोक्यराज्यस्य हेतोः किं नु महीकृते॥",4.85,9.35]]},{"n":36,"d":10.55,"p":[["निहत्य धार्तराष्ट्रान्नः का प्रीतिः स्याज्जनार्दन।",0.0,5.06],["पापमेवाश्रयेदस्मान् हत्वैतानाततायिनः॥",5.45,10.55]]},{"n":37,"d":9.93,"p":[["तस्मान्नार्हा वयं हन्तुं धार्तराष्ट्रान्स्वबान्धवान्।",0.0,5.07],["स्वजनं हि कथं हत्वा सुखिनः स्याम माधव॥",5.64,9.93]]},{"n":38,"d":9.51,"p":[["यद्यप्येते न पश्यन्ति लोभोपहतचेतसः।",0.0,4.67],["कुलक्षयकृतं दोषं मित्रद्रोहे च पातकम्॥",5.01,9.51]]},{"n":39,"d":10.03,"p":[["कथं न ज्ञेयमस्माभिः पापादस्मान्निवर्तितुम्।",0.0,5.12],["कुलक्षयकृतं दोषं प्रपश्यद्भिर्जनार्दन॥",5.61,10.03]]},{"n":40,"d":9.31,"p":[["कुलक्षये प्रणश्यन्ति कुलधर्माः सनातनाः।",0.0,4.41],["धर्मे नष्टे कुलं कृत्स्‍नमधर्मोऽभिभवत्युत॥",4.93,9.31]]},{"n":41,"d":9.39,"p":[["अधर्माभिभवात्कृष्ण प्रदुष्यन्ति कुलस्त्रियः।",0.0,4.49],["स्त्रीषु दुष्टासु वार्ष्णेय जायते वर्णसङ्करः॥",4.77,9.39]]},{"n":42,"d":9.37,"p":[["सङ्करो नरकायैव कुलघ्नानां कुलस्य च।",0.0,4.46],["पतन्ति पितरो ह्येषां लुप्तपिण्डोदकक्रियाः॥",4.76,9.37]]},{"n":43,"d":10.29,"p":[["दोषैरेतैः कुलघ्नानां वर्णसङ्करकारकैः।",0.0,5.13],["उत्साद्यन्ते जातिधर्माः कुलधर्माश्च शाश्वताः॥",5.48,10.29]]},{"n":44,"d":9.11,"p":[["उत्सन्नकुलधर्माणां मनुष्याणां जनार्दन।",0.0,4.61],["नरकेऽनियतं वासो भवतीत्यनुशुश्रुम॥",4.97,9.11]]},{"n":45,"d":9.23,"p":[["अहो बत महत्पापं कर्तुं व्यवसिता वयम्।",0.0,4.38],["यद्राज्यसुखलोभेन हन्तुं स्वजनमुद्यताः॥",4.97,9.23]]},{"n":46,"d":9.53,"p":[["यदि मामप्रतीकार-मशस्त्रं शस्त्रपाणयः।",0.0,4.45],["धार्तराष्ट्रा रणे हन्युस्-तन्मे क्षेमतरं भवेत्॥",4.92,9.53]]},{"n":47,"d":9.13,"p":[["सञ्जय उवाच",0.04,1.33,"UV_sanjaya"],["एवमुक्त्वार्जुनः सङ्ख्ये रथोपस्थ उपाविशत्।",0.0,4.19],["विसृज्य सशरं चापं शोकसंविग्नमानसः॥",4.76,9.13]]}]}