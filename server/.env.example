ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web
# application). Add this app's URL to "Authorized JavaScript origins". No client secret
# needed -- the frontend uses Google Identity Services + the server verifies the ID token.
GOOGLE_CLIENT_ID=
# From turso.tech -> your database -> "Create Token". Leave both blank for local dev
# (db.js then uses a local file at server/data/swadhyay.sqlite, no account needed) --
# REQUIRED on Vercel, since serverless functions there have no writable local disk.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
