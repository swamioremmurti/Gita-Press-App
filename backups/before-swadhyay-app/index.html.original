const CATS = [
  {key:'Vedas', hi:'वेद', count:4},
  {key:'Upanishad', hi:'उपनिषद्', count:9},
  {key:'Vedant', hi:'वेदान्त', count:4},
  {key:'Gita', hi:'गीता', count:22},
  {key:'Purans', hi:'पुराण', count:16},
  {key:'Upa Puran', hi:'उपपुराण', count:0},
  {key:'Itihasas', hi:'इतिहास', count:4},
  {key:'Naamavali', hi:'नामावली', count:25},
  {key:'Stotras', hi:'स्तोत्र', count:1},
  {key:'Bajans', hi:'भजन', count:8},
  {key:'Pravachan', hi:'प्रवचन', count:263},
  {key:'Siksha evam Katha', hi:'शिक्षा एवं कथा', count:127},
  {key:'Balaupayogi', hi:'बालोपयोगी', count:9},
  {key:'Nitya Puja evam Karmakand', hi:'नित्य पूजा एवं कर्मकाण्ड', count:16},
];


const BOOK_DIR = 'Gita Press Books/Gita Press Books/';
let activeCat = 'ALL';

function letterOf(title) {
  return title.charAt(0);
}

function render() {
  const q = document.getElementById('search').value.trim().toLowerCase();
  const main = document.getElementById('main');
  main.innerHTML = '';

  let list = BOOKS;
  if (activeCat !== 'ALL') list = list.filter(b => b.c === activeCat);
  if (q) list = list.filter(b => b.t.toLowerCase().includes(q));

  if (list.length === 0) {
    main.innerHTML = '<div class="empty-msg">कोई ग्रंथ नहीं मिला / No books found</div>';
    return;
  }

  const catsToShow = activeCat === 'ALL' ? CATS.map(c=>c.key) : [activeCat];
  for (const catKey of catsToShow) {
    const catBooks = list.filter(b => b.c === catKey);
    if (catBooks.length === 0) continue;
    const catInfo = CATS.find(c => c.key === catKey);
    const h2 = document.createElement('h2');
    h2.className = 'cat-heading';
    h2.textContent = catInfo.hi + ' / ' + catInfo.key;
    const badge = document.createElement('span');
    badge.className = 'count-badge';
    badge.textContent = '(' + catBooks.length + ')';
    h2.appendChild(badge);
    main.appendChild(h2);

    const byLetter = {};
    for (const b of catBooks) {
      const l = letterOf(b.t);
      if (!byLetter[l]) byLetter[l] = [];
      byLetter[l].push(b);
    }
    const letters = Object.keys(byLetter).sort();
    for (const l of letters) {
      const group = document.createElement('div');
      group.className = 'letter-group';
      const h3 = document.createElement('h3');
      h3.textContent = l;
      group.appendChild(h3);
      const ul = document.createElement('ul');
      ul.className = 'book-list';
      for (const b of byLetter[l].sort((a,b)=>a.t.localeCompare(b.t,'hi'))) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = BOOK_DIR + encodeURIComponent(b.f);
        a.appendChild(document.createTextNode(b.t));
        if (b.a) {
          const authorSpan = document.createElement('span');
          authorSpan.className = 'author';
          authorSpan.textContent = b.a;
          a.appendChild(authorSpan);
        }
        li.appendChild(a);
        ul.appendChild(li);
      }
      group.appendChild(ul);
      main.appendChild(group);
    }
  }
}

function buildTabs() {
  const tabs = document.getElementById('tabs');
  const allBtn = document.createElement('button');
  allBtn.textContent = 'सभी / All';
  const allCnt = document.createElement('span');
  allCnt.className = 'cnt';
  allCnt.textContent = '(' + BOOKS.length + ')';
  allBtn.appendChild(allCnt);
  allBtn.className = 'active';
  allBtn.onclick = () => setActive('ALL', allBtn);
  tabs.appendChild(allBtn);

  for (const c of CATS) {
    const btn = document.createElement('button');
    btn.textContent = c.hi + ' / ' + c.key;
    const cnt = document.createElement('span');
    cnt.className = 'cnt';
    cnt.textContent = '(' + c.count + ')';
    btn.appendChild(cnt);
    btn.onclick = () => setActive(c.key, btn);
    tabs.appendChild(btn);
  }
}

function setActive(key, btn) {
  activeCat = key;
  document.querySelectorAll('nav.tabs button').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  render();
}

document.getElementById('search').addEventListener('input', render);
document.getElementById('totalCount').textContent = BOOKS.length;
buildTabs();
render();
</script>
</body>
</html>