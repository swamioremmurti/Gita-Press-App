# Local-only server files (secrets, local database, search index, logs, helper scripts).
# server/lib is what the API functions need and is still uploaded.
server/.env
server/node_modules
server/index
server/data
server/*.log
server/*.bat
server/build-index.js
server/check-status.js
server/test-retrieval.js

