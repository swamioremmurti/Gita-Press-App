backups
css-audit
tools
.claude
.git
.gitattributes
.env*
.vercel

# Books and media served from the CDN (tools/cdn/upload.mjs, then swadhyay-config.js).
# Uncomment ONLY after the upload is done and swadhyay-config.js points at it -- otherwise the site loses its books.
# Gita Press Books
# assets/audio
# assets/video

# Local-only server files (secrets, local database, search index, logs, helper scripts).
# server/lib is what the API functions need and is still uploaded.
server/.env
server/node_modules
server/index
server/data
server/*.log
server/*.bat
server/build-index.js
server/check-status.js
server/test-retrieval.js

# the speech service is its own deployment (a Hugging Face Space), not part of this site
asr-service

# RAG generator tool + its multi-GB output; only server/rag (the packed chat index) ships
rag-generator

# source data for the importers and the database seed (the site reads server/lib/vrat-catalogue.json instead), and the docs
database
docs

# local-only entry point and helper (Vercel runs api/router.js and api/seo.js)
server/server.js
server/create-editor.js
server/.env.example

# design prototype of the new home page: local only until the design is decided (served at /home-v2/ by server/server.js)
home-v2
